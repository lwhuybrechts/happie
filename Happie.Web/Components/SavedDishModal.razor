@using Happie.Shared.Contracts
@inject IStringLocalizer<AppStrings> Localizer
@inject IJSRuntime JS
@inject HttpClient Http

@if (_isOpen)
{
    <div class="saved-dish-modal__overlay" @onclick="Close" aria-hidden="true"></div>

    <div class="saved-dish-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="saved-dish-modal-title">

        <div class="saved-dish-modal__header">
            <h2 id="saved-dish-modal-title" class="saved-dish-modal__title">@Localizer["SavedDish_ModalTitle"]</h2>
            <button class="saved-dish-modal__close-btn"
                    @onclick="Close"
                    aria-label="@Localizer["NudgeModal_Close"]">
                <span aria-hidden="true">✕</span>
            </button>
        </div>

        <div class="saved-dish-modal__body">
            @if (!string.IsNullOrEmpty(_promoteError))
            {
                <p class="saved-dish-modal__error">@_promoteError</p>
            }

            @if (ShowPromoteOption)
            {
                <button class="saved-dish-modal__action-item saved-dish-modal__action-item--promote"
                        @onclick="HandlePromoteAsync"
                        disabled="@_isPromoting">
                    @string.Format(Localizer["SavedDish_Promote"].Value, _currentDescription.Trim())
                </button>
            }

            @if (_sortedDishes.Count > 0)
            {
                @if (IsAtLimit)
                {
                    <p class="saved-dish-modal__limit-message">@Localizer["SavedDish_SelectionLimit"]</p>
                }

                <ul class="saved-dish-modal__list" @ref="_listRef">
                    @foreach (var dish in _sortedDishes)
                    {
                        var isSelected = _selectedDishIds.Contains(dish.Id);
                        var isDisabled = !isSelected && IsAtLimit;

                        <li class="saved-dish-modal__list-item" id="@($"saved-dish-{dish.Id}")">
                            <button class="saved-dish-modal__dish-btn @(isSelected ? "saved-dish-modal__dish-btn--selected" : "") @(isDisabled ? "saved-dish-modal__dish-btn--disabled" : "")"
                                    @onclick="() => ToggleDish(dish)"
                                    disabled="@isDisabled"
                                    aria-pressed="@isSelected.ToString().ToLower()">
                                <span class="saved-dish-modal__checkmark @(isSelected ? "saved-dish-modal__checkmark--visible" : "")">✓</span>
                                <span class="saved-dish-modal__dish-name">@dish.Description</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="saved-dish-modal__empty">@Localizer["SavedDish_EmptyState"]</p>
            }
        </div>

        <div class="saved-dish-modal__footer">
            <p class="saved-dish-modal__preview">@CombinedDescriptionPreview</p>
            <div class="saved-dish-modal__footer-buttons">
                <button class="saved-dish-modal__confirm-btn"
                        disabled="@(_selectedDishIds.Count == 0)"
                        @onclick="ConfirmAsync">
                    @string.Format(Localizer["SavedDish_ConfirmButton"].Value, _selectedDishIds.Count)
                </button>
                <button class="saved-dish-modal__custom-btn"
                        @onclick="HandleCustomMode">
                    @Localizer["SavedDish_CustomModeButton"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const int SelectionLimit = 10;

    /// <summary>Callback invoked when the user confirms the multi-selection.</summary>
    [Parameter, EditorRequired]
    public EventCallback<IReadOnlyList<SavedDishDto>> OnConfirm { get; set; }

    /// <summary>Callback invoked when the user clicks "Custom mode" (passes Combined_Description).</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnCustomMode { get; set; }

    private bool _isOpen;
    private string _currentDescription = string.Empty;
    private List<SavedDishDto> _sortedDishes = [];
    private List<Guid> _selectedDishIds = [];
    private ElementReference _listRef;
    private Guid? _scrollTargetId;
    private bool _isPromoting;
    private string? _promoteError;

    private bool IsAtLimit => _selectedDishIds.Count >= SelectionLimit;

    private bool ShowPromoteOption
    {
        get
        {
            var trimmed = _currentDescription.Trim();
            if (string.IsNullOrEmpty(trimmed) || trimmed.Length > 100)
                return false;

            // Hide if it matches an existing saved dish (case-insensitive).
            return !_sortedDishes.Any(x =>
                string.Equals(x.Description.Trim(), trimmed, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string CombinedDescriptionPreview
    {
        get
        {
            if (_selectedDishIds.Count == 0)
                return Localizer["SavedDish_SelectPlaceholder"];

            var descriptions = _selectedDishIds
                .Select(id => _sortedDishes.FirstOrDefault(x => x.Id == id))
                .Where(x => x is not null)
                .Select(x => x!.Description);

            return string.Join(" & ", descriptions);
        }
    }

    /// <summary>Opens the modal with the current custom description, list of active saved dishes, and optional pre-selected IDs.</summary>
    public void Open(string currentDescription, IReadOnlyList<SavedDishDto> savedDishes, IReadOnlyList<Guid>? preSelectedIds)
    {
        _currentDescription = currentDescription;
        _promoteError = null;
        _isPromoting = false;
        _sortedDishes = savedDishes
            .OrderBy(x => x.Description, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Initialize selection from pre-selected IDs.
        _selectedDishIds = [];
        _scrollTargetId = null;

        if (preSelectedIds is not null)
        {
            // Add pre-selected IDs that exist in the sorted dishes.
            var validIds = new HashSet<Guid>(_sortedDishes.Select(x => x.Id));
            foreach (var id in preSelectedIds)
            {
                if (validIds.Contains(id))
                    _selectedDishIds.Add(id);
            }
        }

        // Auto-match: if currentDescription matches an active saved dish and it's not already selected, add it.
        var trimmed = _currentDescription.Trim();
        if (!string.IsNullOrEmpty(trimmed))
        {
            var match = _sortedDishes.FirstOrDefault(x =>
                string.Equals(x.Description.Trim(), trimmed, StringComparison.OrdinalIgnoreCase));

            if (match is not null && !_selectedDishIds.Contains(match.Id))
            {
                _selectedDishIds.Add(match.Id);
                _scrollTargetId = match.Id;
            }
            else if (match is not null && _selectedDishIds.Contains(match.Id))
            {
                // Already selected via preSelectedIds, still scroll to it.
                _scrollTargetId = match.Id;
            }
        }

        // If no auto-match scroll target but we have pre-selected items, scroll to the first one.
        if (_scrollTargetId is null && _selectedDishIds.Count > 0)
            _scrollTargetId = _selectedDishIds[0];

        _isOpen = true;
        StateHasChanged();

        // Schedule scroll after render.
        if (_scrollTargetId is not null)
            _ = ScrollToSelectedAsync(_scrollTargetId.Value);
    }

    /// <summary>Closes the modal without any action (preserves previous state).</summary>
    public void Close()
    {
        _isOpen = false;
    }

    /// <summary>Confirms the current selection and invokes the OnConfirm callback.</summary>
    public async Task ConfirmAsync()
    {
        var selectedDishes = _selectedDishIds
            .Select(id => _sortedDishes.First(x => x.Id == id))
            .ToList();

        _isOpen = false;
        await OnConfirm.InvokeAsync(selectedDishes);
    }

    /// <summary>Gets the current selection count for external display (e.g., footer button).</summary>
    public int GetSelectionCount() => _selectedDishIds.Count;

    /// <summary>Gets the currently selected dish IDs.</summary>
    public IReadOnlyList<Guid> GetSelectedIds() => _selectedDishIds;

    private void ToggleDish(SavedDishDto dish)
    {
        if (_selectedDishIds.Contains(dish.Id))
            _selectedDishIds.Remove(dish.Id);
        else if (!IsAtLimit)
            _selectedDishIds.Add(dish.Id);
    }

    private async Task HandleCustomMode()
    {
        // Compute Combined_Description from current selection.
        string prefillText;
        if (_selectedDishIds.Count > 0)
        {
            var descriptions = _selectedDishIds
                .Select(id => _sortedDishes.FirstOrDefault(x => x.Id == id))
                .Where(x => x is not null)
                .Select(x => x!.Description);

            prefillText = string.Join(" & ", descriptions);
        }
        else
        {
            // No dishes selected — pass the existing custom description.
            prefillText = _currentDescription;
        }

        _isOpen = false;
        await OnCustomMode.InvokeAsync(prefillText);
    }

    private async Task HandlePromoteAsync()
    {
        _isPromoting = true;
        _promoteError = null;

        try
        {
            var trimmed = _currentDescription.Trim();
            var response = await Http.PostAsJsonAsync("saved-dishes", new CreateSavedDishRequest(trimmed));

            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<SavedDishDto>();
                if (created is not null)
                {
                    // Add to the sorted list and auto-check it.
                    _sortedDishes.Add(created);
                    _sortedDishes = _sortedDishes.OrderBy(x => x.Description, StringComparer.OrdinalIgnoreCase).ToList();
                    if (!_selectedDishIds.Contains(created.Id) && !IsAtLimit)
                        _selectedDishIds.Add(created.Id);
                }
            }
            else if ((int)response.StatusCode == 409)
            {
                // Already exists — show error and auto-check the match.
                _promoteError = Localizer["SavedDish_PromoteAlreadyExists"].Value;
                var match = _sortedDishes.FirstOrDefault(x =>
                    string.Equals(x.Description.Trim(), _currentDescription.Trim(), StringComparison.OrdinalIgnoreCase));
                if (match is not null && !_selectedDishIds.Contains(match.Id) && !IsAtLimit)
                    _selectedDishIds.Add(match.Id);
            }
            else
            {
                _promoteError = Localizer["SavedDish_PromoteError"].Value;
            }
        }
        catch
        {
            _promoteError = Localizer["SavedDish_PromoteError"].Value;
        }
        finally
        {
            _isPromoting = false;
        }
    }

    private async Task ScrollToSelectedAsync(Guid dishId)
    {
        // Wait for the render to complete.
        await Task.Yield();
        await Task.Delay(50);

        try
        {
            await JS.InvokeVoidAsync("happie.scrollIntoView", $"saved-dish-{dishId}");
        }
        catch
        {
            // Scroll is best-effort; ignore errors.
        }
    }
}
