@inject SyncToastState SyncToastState
@inject IStringLocalizer<AppStrings> Localizer
@implements IDisposable

@if (SyncToastState.VisibleToasts.Count > 0)
{
    <div class="sync-toast-container" aria-live="polite">
        @foreach (var toast in SyncToastState.VisibleToasts)
        {
            <div class="sync-toast @(toast.Type == ToastType.Info ? "sync-toast--info" : "")" role="alert">
                <span class="sync-toast__message">@toast.Message</span>
                <button class="sync-toast__close"
                        aria-label="@Localizer["SyncToast_CloseAriaLabel"]"
                        @onclick="() => SyncToastState.DismissToast(toast.Id)">
                    ✕
                </button>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        SyncToastState.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SyncToastState.OnStateChanged -= HandleStateChanged;
    }
}
