@using System.Globalization
@using Happie.Shared.Domain
@inject LocaleService LocaleService
@inject IStringLocalizer<AppStrings> Localizer
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

@{
    var culture = new CultureInfo(LocaleService.CurrentLocale.ToCultureCode());
    var label = DateLabelService.GetLabel(ViewedDate, DateOnly.FromDateTime(DateTime.Today), culture,
        Localizer["DateNav_Today"], Localizer["DateNav_Yesterday"], Localizer["DateNav_Tomorrow"]);
}

<div class="date-nav" @ref="_navElement">
    <button class="date-nav__arrow date-nav__arrow--left" @onclick="OnPreviousDay" aria-label="Previous day">
        <svg class="date-nav__arrow-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </button>

    @if (EnableSliding)
    {
        var prevLabel = DateLabelService.GetLabel(PreviousDate, DateOnly.FromDateTime(DateTime.Today), culture,
            Localizer["DateNav_Today"], Localizer["DateNav_Yesterday"], Localizer["DateNav_Tomorrow"]);
        var nextLabel = DateLabelService.GetLabel(NextDate, DateOnly.FromDateTime(DateTime.Today), culture,
            Localizer["DateNav_Today"], Localizer["DateNav_Yesterday"], Localizer["DateNav_Tomorrow"]);

        <div class="date-nav__slider-viewport">
            <div class="date-nav__slider-track">
                @* Previous date label. *@
                <div class="date-nav__slider-item" aria-hidden="true">
                    <div class="date-nav__center date-nav__center--static">
                        @if (PreviousCenterText is not null)
                        {
                            <span class="date-nav__title date-nav__title--bold">@PreviousCenterText</span>
                        }
                        else if (prevLabel.Title is not null)
                        {
                            <span class="date-nav__title @(prevLabel.TitleIsBold ? "date-nav__title--bold" : "")">@prevLabel.Title</span>
                            <span class="date-nav__date">@prevLabel.FormattedDate</span>
                        }
                        else
                        {
                            <span class="date-nav__date @(prevLabel.DateIsBold ? "date-nav__date--bold" : "")">@prevLabel.FormattedDate</span>
                        }
                    </div>
                </div>

                @* Current date label. *@
                <div class="date-nav__slider-item">
                    <button class="date-nav__center @(OnCenterClicked.HasDelegate ? "" : "date-nav__center--static")"
                            @onclick="OnCenterClicked"
                            disabled="@(!OnCenterClicked.HasDelegate)"
                            aria-label="@(OnCenterClicked.HasDelegate ? "Open calendar" : null)">
                        @if (CenterText is not null)
                        {
                            <span class="date-nav__title date-nav__title--bold">@CenterText</span>
                        }
                        else if (label.Title is not null)
                        {
                            <span class="date-nav__title @(label.TitleIsBold ? "date-nav__title--bold" : "")">@label.Title</span>
                            <span class="date-nav__date">@label.FormattedDate</span>
                        }
                        else
                        {
                            <span class="date-nav__date @(label.DateIsBold ? "date-nav__date--bold" : "")">@label.FormattedDate</span>
                        }
                    </button>
                </div>

                @* Next date label. *@
                <div class="date-nav__slider-item" aria-hidden="true">
                    <div class="date-nav__center date-nav__center--static">
                        @if (NextCenterText is not null)
                        {
                            <span class="date-nav__title date-nav__title--bold">@NextCenterText</span>
                        }
                        else if (nextLabel.Title is not null)
                        {
                            <span class="date-nav__title @(nextLabel.TitleIsBold ? "date-nav__title--bold" : "")">@nextLabel.Title</span>
                            <span class="date-nav__date">@nextLabel.FormattedDate</span>
                        }
                        else
                        {
                            <span class="date-nav__date @(nextLabel.DateIsBold ? "date-nav__date--bold" : "")">@nextLabel.FormattedDate</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <button class="date-nav__center @(OnCenterClicked.HasDelegate ? "" : "date-nav__center--static")"
                @onclick="OnCenterClicked"
                disabled="@(!OnCenterClicked.HasDelegate)"
                aria-label="@(OnCenterClicked.HasDelegate ? "Open calendar" : null)">
            @if (CenterText is not null)
            {
                <span class="date-nav__title date-nav__title--bold">@CenterText</span>
            }
            else if (label.Title is not null)
            {
                <span class="date-nav__title @(label.TitleIsBold ? "date-nav__title--bold" : "")">@label.Title</span>
                <span class="date-nav__date">@label.FormattedDate</span>
            }
            else
            {
                <span class="date-nav__date @(label.DateIsBold ? "date-nav__date--bold" : "")">@label.FormattedDate</span>
            }
        </button>
    }

    <button class="date-nav__arrow date-nav__arrow--right" @onclick="OnNextDay" aria-label="Next day">
        <svg class="date-nav__arrow-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
        </svg>
    </button>
</div>

@code {
    /// <summary>The date currently being viewed.</summary>
    [Parameter, EditorRequired]
    public DateOnly ViewedDate { get; set; }

    /// <summary>Optional override text for the center area (e.g., month/year on CalendarPage).</summary>
    [Parameter]
    public string? CenterText { get; set; }

    /// <summary>Callback invoked when the user clicks the previous day arrow.</summary>
    [Parameter]
    public EventCallback OnPreviousDay { get; set; }

    /// <summary>Callback invoked when the user clicks the next day arrow.</summary>
    [Parameter]
    public EventCallback OnNextDay { get; set; }

    /// <summary>Callback invoked when the user clicks the center date area.</summary>
    [Parameter]
    public EventCallback OnCenterClicked { get; set; }

    /// <summary>When true, the center text area supports horizontal sliding for swipe preview.</summary>
    [Parameter]
    public bool EnableSliding { get; set; }

    /// <summary>The previous day's date, used for the sliding label.</summary>
    [Parameter]
    public DateOnly PreviousDate { get; set; }

    /// <summary>The next day's date, used for the sliding label.</summary>
    [Parameter]
    public DateOnly NextDate { get; set; }

    /// <summary>Optional override text for the previous slider item (e.g., previous month label).</summary>
    [Parameter]
    public string? PreviousCenterText { get; set; }

    /// <summary>Optional override text for the next slider item (e.g., next month label).</summary>
    [Parameter]
    public string? NextCenterText { get; set; }

    private ElementReference _navElement;
    private DotNetObjectReference<DateNavigationPanel>? _dotNetRef;
    private bool _wheelRegistered;

    /// <summary>Exposes the root element reference for external JS interop registration.</summary>
    public ElementReference NavElement => _navElement;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("happie.registerWheelNavigation", _navElement, _dotNetRef);
            _wheelRegistered = true;
        }
    }

    [JSInvokable]
    public async Task WheelPreviousAsync()
    {
        await OnPreviousDay.InvokeAsync();
    }

    [JSInvokable]
    public async Task WheelNextAsync()
    {
        await OnNextDay.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_wheelRegistered)
            await JsRuntime.InvokeVoidAsync("happie.unregisterWheelNavigation", _navElement);
        _dotNetRef?.Dispose();
    }
}
