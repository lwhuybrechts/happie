@inherits LayoutComponentBase
@inject SessionService SessionService
@inject IStringLocalizer<AppStrings> Localizer

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <LocaleSwitcher />
            <button @onclick="LogoutAsync" class="btn btn-link">@Localizer["Logout"]</button>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private Task LogoutAsync() => SessionService.LogoutAsync();
}
