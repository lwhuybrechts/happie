@inherits LayoutComponentBase
@inject PushNotificationService PushNotificationService
@inject ActiveHousemateService ActiveHousemateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<AppStrings> Localizer
@implements IDisposable

<div class="page">
    <div class="sidebar-container">
        <Sidebar />
    </div>

    <div class="mobile-header-container">
        <MobileHeader />
    </div>

    <main>
        <article class="content">
            <OfflineBanner />
            @if (PushNotificationService.ShouldShowEnablePrompt && _showEnablePrompt)
            {
                <div class="push-enable-banner" role="alert">
                    <span>@Localizer["Push_EnablePrompt"]</span>
                    <div class="push-enable-banner__actions">
                        <button class="push-enable-banner__enable" @onclick="EnablePush">@Localizer["Push_EnableButton"]</button>
                        <button class="push-enable-banner__dismiss" @onclick="DismissEnablePrompt" aria-label="@Localizer["Push_DismissAriaLabel"]">✕</button>
                    </div>
                </div>
            }
            @if (PushNotificationService.PermissionDenied && _showDeniedMessage)
            {
                <div class="push-denied-banner" role="alert">
                    <span>@Localizer["Push_PermissionDenied"] <a class="push-denied-banner__link" href="/push-help">@Localizer["Push_HowToEnable"]</a></span>
                    <button class="push-denied-banner__dismiss" @onclick="DismissDeniedBanner" aria-label="@Localizer["Push_DismissAriaLabel"]">✕</button>
                </div>
            }
            @Body
        </article>
    </main>

    <div class="mobile-bottom-nav-container">
        <MobileBottomNav />
    </div>

    <SyncToast />
</div>

@code {
    private bool _showDeniedMessage;
    private bool _showEnablePrompt = true;

    protected override void OnInitialized()
    {
        PushNotificationService.OnPermissionStateChanged += HandlePermissionStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ActiveHousemateService.Id.HasValue)
        {
            await PushNotificationService.CheckPermissionStateAsync();

            // Check if the app was launched from a notification click with a deep link.
            var pending = await JsRuntime.InvokeAsync<PendingNavigation?>("happie.checkPendingNavigation");
            if (pending is not null && !string.IsNullOrWhiteSpace(pending.Url))
            {
                var currentHouseholdId = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", "householdId");

                // If the notification is from a different household, clear session and redirect to login with returnUrl.
                if (!string.IsNullOrWhiteSpace(pending.HouseholdId) && !string.IsNullOrWhiteSpace(currentHouseholdId) && pending.HouseholdId != currentHouseholdId)
                {
                    await JsRuntime.InvokeVoidAsync("localStorage.removeItem", "jwt");
                    await JsRuntime.InvokeVoidAsync("localStorage.removeItem", "activeHousemateId");
                    await JsRuntime.InvokeVoidAsync("localStorage.removeItem", "activeHousemateName");
                    await JsRuntime.InvokeVoidAsync("localStorage.removeItem", "activeHousemateColor");
                    await JsRuntime.InvokeVoidAsync("localStorage.removeItem", "householdId");
                    await JsRuntime.InvokeVoidAsync("localStorage.setItem", "returnUrl", pending.Url);
                    await JsRuntime.InvokeVoidAsync("localStorage.setItem", "returnUrlHouseholdId", pending.HouseholdId);
                    NavigationManager.NavigateTo("/", forceLoad: true);
                }
                else if (pending.Url != NavigationManager.ToBaseRelativePath(NavigationManager.Uri))
                {
                    NavigationManager.NavigateTo(pending.Url);
                }
            }
        }
    }

    private record PendingNavigation(
        [property: System.Text.Json.Serialization.JsonPropertyName("url")] string? Url,
        [property: System.Text.Json.Serialization.JsonPropertyName("householdId")] string? HouseholdId);

    private async Task EnablePush()
    {
        // This is called from a button click — user gesture context is preserved.
        await PushNotificationService.RequestPermissionAsync();
        _showEnablePrompt = false;
    }

    private void HandlePermissionStateChanged()
    {
        _showDeniedMessage = PushNotificationService.PermissionDenied;
        _showEnablePrompt = PushNotificationService.ShouldShowEnablePrompt;
        InvokeAsync(StateHasChanged);
    }

    private void DismissEnablePrompt()
    {
        _showEnablePrompt = false;
    }

    private void DismissDeniedBanner()
    {
        _showDeniedMessage = false;
    }

    public void Dispose()
    {
        PushNotificationService.OnPermissionStateChanged -= HandlePermissionStateChanged;
    }
}
