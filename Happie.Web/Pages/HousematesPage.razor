@page "/housemates"
@using Happie.Shared.Contracts
@using Happie.Shared.Domain
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> Localizer
@inject SessionService SessionService
@inject ActiveHousemateService ActiveHousemateService
@inject IConfiguration Configuration

<PageTitle>Happie</PageTitle>

<div class="housemates-page">

    @* Title bar with plus button. *@
    <div class="housemates-page__header">
        <h1 class="housemates-page__title">@Localizer["Housemates_Title"]</h1>
        <button class="housemates-page__add-btn"
                @onclick="ToggleAddForm"
                aria-label="@Localizer["Housemates_AddButton"]">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
        </button>
    </div>

    @* Add housemate form — shown when plus is clicked. *@
    @if (_showAddForm)
    {
        <div class="housemates-page__add-panel">
            <input class="housemates-page__input"
                   @ref="_addInputRef"
                   @bind="_newHousemateName"
                   @bind:event="oninput"
                   @onkeydown="OnAddKeyDownAsync"
                   maxlength="50"
                   placeholder="@Localizer["Housemates_NamePlaceholder"]"
                   aria-label="@Localizer["Housemates_NamePlaceholder"]" />
            <button class="housemates-page__action-btn housemates-page__action-btn--accept"
                    @onclick="AddHousemateAsync"
                    disabled="@(!IsValidNewName)"
                    aria-label="@Localizer["Housemates_SaveRename"]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
            </button>
            <button class="housemates-page__action-btn housemates-page__action-btn--discard"
                    @onclick="CancelAdd"
                    aria-label="@Localizer["Housemates_CancelRename"]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m15 9-6 6" />
                    <path d="m9 9 6 6" />
                </svg>
            </button>
        </div>
    }

    @* Housemate list. *@
    @if (_isLoading)
    {
        <p>@Localizer["DayPlan_Loading"]</p>
    }
    else if (_loadError)
    {
        <p role="alert">@Localizer["Housemates_LoadError"]</p>
    }
    else
    {
        <ul class="housemates-page__list" aria-label="@Localizer["Housemates_Title"]">
            @for (var i = 0; i < _housemates.Count; i++)
            {
                var housemate = _housemates[i];
                var index = i;
                var isActive = _activeHousemateId == housemate.Id;

                <li class="housemates-page__item @(isActive ? "housemates-page__item--active" : "")"
                    @onclick="() => SelectHousemateAsync(housemate)"
                    role="@(isActive ? null : "button")"
                    aria-label="@(isActive ? housemate.Name : Localizer["Housemates_SwitchTo", housemate.Name])"
                    aria-current="@(isActive ? "true" : null)">

                    @if (_editingHousemateId == housemate.Id)
                    {
                        @* Rename mode: input + V/X buttons. *@
                        <div class="housemates-page__edit-row">
                            <HousemateAvatar Name="@housemate.Name" Color="@housemate.Color" />
                            <input class="housemates-page__input"
                                   @ref="_editInputRef"
                                   @bind="_editName"
                                   @bind:event="oninput"
                                   @onkeydown="OnRenameKeyDownAsync"
                                   @onclick:stopPropagation="true"
                                   maxlength="50"
                                   aria-label="@Localizer["Housemates_RenameAriaLabel", housemate.Name]" />
                            <button class="housemates-page__action-btn housemates-page__action-btn--accept"
                                    @onclick="() => SaveRenameAsync(housemate)"
                                    @onclick:stopPropagation="true"
                                    disabled="@(!IsValidRename(housemate.Name))"
                                    aria-label="@Localizer["Housemates_SaveRename"]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="m9 12 2 2 4-4" />
                                </svg>
                            </button>
                            <button class="housemates-page__action-btn housemates-page__action-btn--discard"
                                    @onclick="CancelRename"
                                    @onclick:stopPropagation="true"
                                    aria-label="@Localizer["Housemates_CancelRename"]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="m15 9-6 6" />
                                    <path d="m9 9 6 6" />
                                </svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        @* Display mode: avatar + name on left, action buttons on right. *@
                        <div class="housemates-page__row">
                            <div class="housemates-page__identity">
                                <HousemateAvatar Name="@housemate.Name" Color="@housemate.Color" />
                                <span class="housemates-page__name">@housemate.Name</span>
                            </div>
                            <div class="housemates-page__actions">
                                <button class="housemates-page__icon-btn"
                                        @onclick="() => StartRename(housemate)"
                                        @onclick:stopPropagation="true"
                                        aria-label="@Localizer["Housemates_Rename", housemate.Name]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </button>
                                <button class="housemates-page__icon-btn"
                                        @onclick="() => OpenColorModal(housemate)"
                                        @onclick:stopPropagation="true"
                                        aria-label="@Localizer["Housemates_ChangeColor", housemate.Name]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="13.5" cy="6.5" r="2.5" />
                                        <circle cx="17.5" cy="10.5" r="2.5" />
                                        <circle cx="8.5" cy="7.5" r="2.5" />
                                        <circle cx="6.5" cy="12.5" r="2.5" />
                                        <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12c0 2.4.846 4.604 2.256 6.328.39.477.863.672 1.394.672H8.5a1.5 1.5 0 0 0 1.5-1.5V17a2 2 0 0 1 2-2z" />
                                    </svg>
                                </button>
                                <button class="housemates-page__icon-btn housemates-page__icon-btn--danger"
                                        @onclick="() => ConfirmRemove(housemate)"
                                        @onclick:stopPropagation="true"
                                        aria-label="@Localizer["Housemates_Remove", housemate.Name]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                </button>
                                <button class="housemates-page__icon-btn"
                                        @onclick="() => MoveHousemateAsync(index, -1)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(index == 0)"
                                        aria-label="@Localizer["Housemates_MoveUp", housemate.Name]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="18 15 12 9 6 15" />
                                    </svg>
                                </button>
                                <button class="housemates-page__icon-btn"
                                        @onclick="() => MoveHousemateAsync(index, 1)"
                                        @onclick:stopPropagation="true"
                                        disabled="@(index == _housemates.Count - 1)"
                                        aria-label="@Localizer["Housemates_MoveDown", housemate.Name]">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>

        @* Logout button. *@
        <div class="housemates-page__footer-row">
            <span class="housemates-page__version">v@(Configuration["AppVersion"])</span>
            <button class="housemates-page__logout-btn" @onclick="LogoutAsync">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                @Localizer["Logout"]
            </button>
        </div>
    }

    @* Color picker modal. *@
    <ColorPickerModal @ref="_colorPickerModal" OnColorSelected="OnColorSelectedAsync" />

    @* Remove confirmation modal. *@
    @if (_confirmRemoveHousemate is not null)
    {
        <div class="modal-overlay" @onclick="CancelRemove" aria-hidden="true"></div>
        <div class="modal-dialog" role="alertdialog" aria-labelledby="remove-dialog-title">
            <h2 id="remove-dialog-title">@Localizer["Housemates_RemoveConfirmTitle"]</h2>
            @if (_isLastHousemate)
            {
                <p>@Localizer["Housemates_RemoveLastWarning", _confirmRemoveHousemate.Name]</p>
            }
            else
            {
                <p>@Localizer["Housemates_RemoveConfirmMessage", _confirmRemoveHousemate.Name]</p>
            }
            <div class="modal-actions">
                <button class="modal-btn modal-btn--cancel" @onclick="CancelRemove">@Localizer["Housemates_RemoveCancel"]</button>
                <button class="modal-btn modal-btn--danger" @onclick="RemoveHousemateAsync">@Localizer["Housemates_RemoveConfirm"]</button>
            </div>
        </div>
    }

    @* Error toast. *@
    @if (_showError)
    {
        <div class="toast toast--error" role="alert">
            @Localizer["Housemates_SaveError"]
        </div>
    }
</div>

@code {
    private List<HousemateDto> _housemates = new();
    private bool _isLoading = true;
    private bool _loadError;
    private bool _showError;
    private Guid _activeHousemateId;

    // Add form state.
    private bool _showAddForm;
    private string _newHousemateName = string.Empty;
    private ElementReference _addInputRef;
    private bool _shouldFocusAdd;

    // Rename state.
    private Guid? _editingHousemateId;
    private string _editName = string.Empty;
    private ElementReference _editInputRef;
    private bool _shouldFocusEdit;

    // Color picker state.
    private HousemateDto? _colorPickerHousemate;
    private ColorPickerModal? _colorPickerModal;

    // Remove confirmation state.
    private HousemateDto? _confirmRemoveHousemate;
    private bool _isLastHousemate;

    private bool IsValidNewName => !string.IsNullOrWhiteSpace(_newHousemateName) && _newHousemateName.Trim().Length <= 50;

    private bool IsValidRename(string currentName)
    {
        var trimmed = _editName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed) || trimmed.Length > 50)
            return false;
        if (string.Equals(trimmed, currentName, StringComparison.Ordinal))
            return false;
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        await ActiveHousemateService.InitializeAsync();
        _activeHousemateId = ActiveHousemateService.Id ?? Guid.Empty;
        await LoadHousematesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusAdd)
        {
            _shouldFocusAdd = false;
            try { await _addInputRef.FocusAsync(); } catch { }
        }

        if (_shouldFocusEdit)
        {
            _shouldFocusEdit = false;
            try { await _editInputRef.FocusAsync(); } catch { }
        }
    }

    private async Task LoadHousematesAsync()
    {
        _isLoading = true;
        _loadError = false;

        try
        {
            var response = await Http.GetAsync("housemates");

            if (response.IsSuccessStatusCode)
            {
                var housemates = await response.Content.ReadFromJsonAsync<List<HousemateDto>>();
                // Server returns them sorted by SortOrder already.
                _housemates = housemates ?? new();
            }
            else
            {
                _loadError = true;
            }
        }
        catch
        {
            _loadError = true;
        }

        _isLoading = false;
    }

    // --- Add housemate ---

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _newHousemateName = string.Empty;

        if (_showAddForm)
            _shouldFocusAdd = true;
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _newHousemateName = string.Empty;
    }

    private async Task AddHousemateAsync()
    {
        if (!IsValidNewName)
            return;

        var trimmedName = _newHousemateName.Trim();
        _newHousemateName = string.Empty;
        _showAddForm = false;

        try
        {
            var response = await Http.PostAsJsonAsync("housemates", new AddHousemateRequest(trimmedName));

            if (response.IsSuccessStatusCode)
                await LoadHousematesAsync();
            else
                ShowError();
        }
        catch
        {
            ShowError();
        }
    }

    private async Task OnAddKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await AddHousemateAsync();
        else if (args.Key == "Escape")
            CancelAdd();
    }

    // --- Select housemate ---

    private async Task SelectHousemateAsync(HousemateDto housemate)
    {
        if (_editingHousemateId is not null)
            return;

        if (_activeHousemateId == housemate.Id)
            return;

        await ActiveHousemateService.SetActiveHousemateAsync(housemate.Id, housemate.Name, housemate.Color);
        _activeHousemateId = housemate.Id;
    }

    // --- Rename ---

    private void StartRename(HousemateDto housemate)
    {
        _editingHousemateId = housemate.Id;
        _editName = housemate.Name;
        _shouldFocusEdit = true;
    }

    private void CancelRename()
    {
        _editingHousemateId = null;
        _editName = string.Empty;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            var housemate = _housemates.FirstOrDefault(x => x.Id == _editingHousemateId);
            if (housemate is not null)
                await SaveRenameAsync(housemate);
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveRenameAsync(HousemateDto housemate)
    {
        var trimmedName = _editName.Trim();

        if (string.IsNullOrWhiteSpace(trimmedName) || trimmedName.Length > 50)
            return;

        _editingHousemateId = null;

        try
        {
            var response = await Http.PatchAsJsonAsync($"housemates/{housemate.Id}", new UpdateHousemateRequest(trimmedName, null));

            if (response.IsSuccessStatusCode)
            {
                await LoadHousematesAsync();

                if (housemate.Id == _activeHousemateId)
                    await ActiveHousemateService.SetActiveHousemateAsync(housemate.Id, trimmedName, housemate.Color);
            }
            else
            {
                ShowError();
            }
        }
        catch
        {
            ShowError();
        }
    }

    // --- Color change ---

    private void OpenColorModal(HousemateDto housemate)
    {
        _colorPickerHousemate = housemate;
        var colorsInUse = _housemates
            .Where(x => x.Id != housemate.Id)
            .Select(x => x.Color);
        _colorPickerModal?.Open(housemate.Name, housemate.Color, colorsInUse);
    }

    private async Task OnColorSelectedAsync(string newColor)
    {
        if (_colorPickerHousemate is null)
            return;

        var housemate = _colorPickerHousemate;
        _colorPickerHousemate = null;

        try
        {
            var response = await Http.PatchAsJsonAsync($"housemates/{housemate.Id}", new UpdateHousemateRequest(null, newColor));

            if (response.IsSuccessStatusCode)
            {
                await LoadHousematesAsync();

                if (housemate.Id == _activeHousemateId)
                    await ActiveHousemateService.SetActiveHousemateAsync(housemate.Id, housemate.Name, newColor);
            }
            else
            {
                ShowError();
            }
        }
        catch
        {
            ShowError();
        }
    }

    // --- Reorder ---

    private async Task MoveHousemateAsync(int currentIndex, int direction)
    {
        var newIndex = currentIndex + direction;
        if (newIndex < 0 || newIndex >= _housemates.Count)
            return;

        // Swap in the local list for immediate UI feedback.
        (_housemates[currentIndex], _housemates[newIndex]) = (_housemates[newIndex], _housemates[currentIndex]);

        // Save the new order to the server.
        var orderedIds = _housemates.Select(x => x.Id).ToList();

        try
        {
            var response = await Http.PutAsJsonAsync("housemates/order", new ReorderHousematesRequest(orderedIds));

            if (!response.IsSuccessStatusCode)
                ShowError();
        }
        catch
        {
            ShowError();
        }
    }

    // --- Remove ---

    private void ConfirmRemove(HousemateDto housemate)
    {
        _confirmRemoveHousemate = housemate;
        _isLastHousemate = _housemates.Count == 1;
    }

    private void CancelRemove()
    {
        _confirmRemoveHousemate = null;
    }

    private async Task RemoveHousemateAsync()
    {
        if (_confirmRemoveHousemate is null)
            return;

        var housemateToRemove = _confirmRemoveHousemate;
        var isDeletingSelf = housemateToRemove.Id == _activeHousemateId;
        _confirmRemoveHousemate = null;

        try
        {
            var response = await Http.DeleteAsync($"housemates/{housemateToRemove.Id}");

            if (response.IsSuccessStatusCode)
            {
                if (isDeletingSelf)
                {
                    await SessionService.LogoutAsync();
                    return;
                }

                await LoadHousematesAsync();
            }
            else
            {
                ShowError();
            }
        }
        catch
        {
            ShowError();
        }
    }

    // --- Logout ---

    private async Task LogoutAsync()
    {
        await SessionService.LogoutAsync();
    }

    // --- Error toast ---

    private void ShowError()
    {
        _showError = true;
        _ = DismissErrorAsync();
    }

    private async Task DismissErrorAsync()
    {
        await Task.Delay(4000);
        _showError = false;
        StateHasChanged();
    }
}
