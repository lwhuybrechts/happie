@page "/housemates/{Id}"
@using Happie.Shared.Contracts
@using Happie.Web.Http
@inject HttpClient Http
@inject IStatisticsApiClient StatisticsApi
@inject NavigationManager NavigationManager
@inject LoadingIndicatorState LoadingIndicator
@inject IStringLocalizer<AppStrings> Localizer
@inject IJSRuntime JS

<PageTitle>Happie</PageTitle>

<div class="housemate-details-page">
    @if (_isLoading)
    {
        <LoadingIndicator />
    }
    else if (_statistics is not null)
    {
        <div class="housemate-details-page__header">
            <button class="housemate-details-page__back-btn" @onclick="NavigateBackAsync" aria-label="Back">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <h1 class="housemate-details-page__title">@Localizer["Stats_HousemateTitle", _housemateName]</h1>
        </div>

        <TimelineChart Rows="_timelineRows"
                       StartDate="_timelineStartDate"
                       EndDate="_timelineEndDate"
                       OnLoadMore="OnLoadMoreTimelineAsync"
                       CanLoadMore="_canLoadMoreTimeline"
                       MaxVisibleRows="5" />

        <TimeRangeSelector SelectedRange="_selectedRange" OnRangeSelected="OnTimeRangeChangedAsync" />

        <div class="housemate-details-page__stats-container @(_isChangingRange ? "housemate-details-page__stats-container--loading" : "")">
            @if (_isChangingRange)
            {
                <div class="housemate-details-page__stats-overlay">
                    <LoadingIndicator />
                </div>
            }

            @if (_statistics.TimesCooked > 0)
            {
                <div class="housemate-details-page__summary">
                    <div class="housemate-details-page__summary-header">
                        <span class="housemate-details-page__summary-header-center">@GetRangeHeaderLabel()</span>
                    </div>
                    <div class="housemate-details-page__summary-grid">
                        <div class="housemate-details-page__summary-cell">
                            <span class="housemate-details-page__summary-value">
                                <svg class="housemate-details-page__stat-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 22" fill="none" stroke="#42A5F5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path stroke-width="1.8" d="M11 2.5c-1.1 0-2.1.5-2.7 1.2C7.6 3.2 6.6 2.8 5.5 3.2 3.9 3.8 3.2 5.5 3.2 6.8c0 1.8.9 3.2 2.3 4.1v2.6h11v-2.6c1.4-.9 2.3-2.3 2.3-4.1 0-1.3-.7-3-2.3-3.6-1.1-.4-2.1 0-2.8.5C13.1 3 12.1 2.5 11 2.5z"/>
                                    <rect stroke-width="1.4" x="5.5" y="14.5" width="11" height="4" rx="1"/>
                                </svg>
                                @_statistics.TimesCooked
                            </span>
                            <span class="housemate-details-page__summary-label">@Localizer["Stats_TimesCooked"]</span>
                        </div>
                        <div class="housemate-details-page__summary-cell">
                            <span class="housemate-details-page__summary-value">
                                <svg class="housemate-details-page__stat-icon housemate-details-page__stat-icon--check" xmlns="http://www.w3.org/2000/svg" viewBox="4 5 14 13" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="6 12 10 16 16 7"/>
                                </svg>
                                @_statistics.DaysEatingIn
                            </span>
                            <span class="housemate-details-page__summary-label">@Localizer["Stats_DaysEatingIn"]</span>
                        </div>
                        <div class="housemate-details-page__summary-cell">
                            <span class="housemate-details-page__summary-value">
                                <svg class="housemate-details-page__stat-icon housemate-details-page__stat-icon--fire" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 92.27 122.88" fill="none" stroke="none" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="fire-outer" x1="50%" y1="100%" x2="50%" y2="0%">
                                            <stop offset="0%" stop-color="#f7971e"/>
                                            <stop offset="60%" stop-color="#f25c2a"/>
                                            <stop offset="100%" stop-color="#d32f2f"/>
                                        </linearGradient>
                                        <linearGradient id="fire-inner" x1="50%" y1="100%" x2="50%" y2="0%">
                                            <stop offset="0%" stop-color="#fff176"/>
                                            <stop offset="100%" stop-color="#ffb74d"/>
                                        </linearGradient>
                                    </defs>
                                    <!-- Outer flame shape. -->
                                    <path fill="url(#fire-outer)" d="M18.61,54.89C15.7,28.8,30.94,10.45,59.52,0C42.02,22.71,74.44,47.31,76.23,70.89 c4.19-7.15,6.57-16.69,7.04-29.45c21.43,33.62,3.66,88.57-43.5,80.67c-4.33-0.72-8.5-2.09-12.3-4.13C10.27,108.8,0,88.79,0,69.68 C0,57.5,5.21,46.63,11.95,37.99C12.85,46.45,14.77,52.76,18.61,54.89L18.61,54.89z"/>
                                    <!-- Inner yellow flame. -->
                                    <path fill="url(#fire-inner)" d="M33.87,92.58c-4.86-12.55-4.19-32.82,9.42-39.93c0.1,23.3,23.05,26.27,18.8,51.14 c3.92-4.44,5.9-11.54,6.25-17.15c6.22,14.24,1.34,25.63-7.53,31.43c-26.97,17.64-50.19-18.12-34.75-37.72 C26.53,84.73,31.89,91.49,33.87,92.58L33.87,92.58z"/>
                                    <!-- Bright core. -->
                                    <ellipse fill="#fff9c4" cx="46" cy="108" rx="8" ry="10"/>
                                </svg>
                                @_statistics.LongestStreak
                            </span>
                            <span class="housemate-details-page__summary-label">@Localizer["Stats_LongestStreak"]</span>
                        </div>
                        <div class="housemate-details-page__summary-cell">
                            <span class="housemate-details-page__summary-value">
                                <svg class="housemate-details-page__stat-icon housemate-details-page__stat-icon--wide" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 22" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <!-- Back chef hat (offset left, lighter blue). -->
                                    <g stroke="#90CAF9">
                                        <path stroke-width="1.6" d="M8 3.5c-1 0-1.8.4-2.3 1C5.2 4.1 4.4 3.8 3.5 4.1 2.2 4.6 1.6 6 1.6 7.1c0 1.5.7 2.7 1.9 3.5v2.2h9.4v-2.2c1.2-.8 1.9-2 1.9-3.5 0-1.1-.6-2.5-1.9-3-1-.4-1.8 0-2.4.4C10.1 3.9 9 3.5 8 3.5z"/>
                                        <rect stroke-width="1.2" x="3.5" y="13.8" width="9.4" height="3.4" rx=".8"/>
                                    </g>
                                    <!-- White fill to mask the back hat behind the front one. -->
                                    <g>
                                        <path fill="#ffffff" stroke="none" d="M19 2.5c-1.1 0-2.1.5-2.7 1.2-0.7-.5-1.7-.9-2.8-.5-1.6.6-2.3 2.3-2.3 3.6 0 1.8.9 3.2 2.3 4.1v2.6h11v-2.6c1.4-.9 2.3-2.3 2.3-4.1 0-1.3-.7-3-2.3-3.6-1.1-.4-2.1 0-2.8.5C21.1 3 20.1 2.5 19 2.5z"/>
                                        <rect fill="#ffffff" stroke="none" x="13.5" y="14.5" width="11" height="4" rx="1"/>
                                    </g>
                                    <!-- Front chef hat (full blue). -->
                                    <g stroke="#42A5F5">
                                        <path stroke-width="1.8" d="M19 2.5c-1.1 0-2.1.5-2.7 1.2-0.7-.5-1.7-.9-2.8-.5-1.6.6-2.3 2.3-2.3 3.6 0 1.8.9 3.2 2.3 4.1v2.6h11v-2.6c1.4-.9 2.3-2.3 2.3-4.1 0-1.3-.7-3-2.3-3.6-1.1-.4-2.1 0-2.8.5C21.1 3 20.1 2.5 19 2.5z"/>
                                        <rect stroke-width="1.4" x="13.5" y="14.5" width="11" height="4" rx="1"/>
                                    </g>
                                </svg>
                                @_statistics.BusiestWeek
                            </span>
                            <span class="housemate-details-page__summary-label">@Localizer["Stats_MostInOneWeek"]</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="housemate-details-page__empty-state">@Localizer["Stats_EmptyState"]</p>
            }

            @if (_statistics.CookRatioEatingInDays > 0)
            {
                <CookRatioRing CookDays="_statistics.CookRatioDays"
                               EatingInDays="_statistics.CookRatioEatingInDays"
                               Color="@_housemateColor"
                               ShortRangeLabel="@GetShortRangeLabel()" />
            }

            @if (_statistics.CookingShares.Sum(x => x.ChefDayCount) > 0)
            {
                <DonutChart Segments="_statistics.CookingShares" HighlightedHousemateId="_housemateId" Title="@Localizer["Stats_CookingShare"]" InfoText="@Localizer["Stats_CookingShare_Info"]" ShortRangeLabel="@GetShortRangeLabel()" />
            }

            @if (_statistics.TimesCooked > 0 && _statistics.TopDishes.Count > 0)
            {
                <div class="housemate-details-page__top-dishes">
                    <h2 class="housemate-details-page__section-title">
                        @Localizer["Stats_TopDishesWithName", _housemateName]<span class="housemate-details-page__section-range">@GetShortRangeLabel()</span>
                    </h2>
                    <ul class="housemate-details-page__top-dishes-list">
                        @foreach (var dish in _statistics.TopDishes)
                        {
                            <li class="housemate-details-page__top-dish-item">
                                <a class="housemate-details-page__top-dish-link" href="saved-dishes/@dish.SavedDishId">
                                    <span class="housemate-details-page__top-dish-description">@dish.Description</span>
                                </a>
                                <span class="housemate-details-page__top-dish-count">@Localizer["Stats_TopDishCount", dish.Count]</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private TimeRange _selectedRange = TimeRange.ThirtyDays;
    private HousemateStatisticsResponse? _statistics;
    private string _housemateName = string.Empty;
    private string _housemateColor = "#6b7280";
    private Guid _housemateId;
    private bool _isLoading = true;
    private bool _isChangingRange;

    // Timeline state.
    private IReadOnlyList<TimelineChart.TimelineChartRow> _timelineRows = [];
    private DateOnly _timelineStartDate;
    private DateOnly _timelineEndDate;
    private bool _canLoadMoreTimeline = true;
    private DateOnly? _timelineFloor;

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var housemateId))
        {
            NavigationManager.NavigateTo("/housemates", replace: true);
            return;
        }

        _housemateId = housemateId;
        await LoadDataAsync(housemateId);
    }

    private async Task LoadDataAsync(Guid housemateId)
    {
        _isLoading = true;
        LoadingIndicator.IncrementAsync();
        StateHasChanged();

        try
        {
            // Load the housemate name and color from the housemates API.
            await LoadHousemateNameAsync(housemateId);

            if (string.IsNullOrEmpty(_housemateName))
            {
                NavigationManager.NavigateTo("/housemates", replace: true);
                return;
            }

            // Load statistics and timeline in parallel.
            var (from, to) = GetDateRange(_selectedRange);
            var (timelineFrom, timelineTo) = GetTimelineRange();

            var statisticsTask = StatisticsApi.GetHousemateStatisticsAsync(housemateId, from, to);
            var timelineTask = StatisticsApi.GetHousemateTimelineAsync(housemateId, timelineFrom, timelineTo);

            await Task.WhenAll(statisticsTask, timelineTask);

            _statistics = await statisticsTask;
            var timeline = await timelineTask;

            if (_statistics is null)
            {
                NavigationManager.NavigateTo("/housemates", replace: true);
                return;
            }

            _timelineStartDate = timelineFrom;
            _timelineEndDate = timelineTo;
            _timelineRows = timeline is not null ? BuildTimelineRows(timeline.Entries) : [];

            // Compute the floor: 1st of the month of the earliest cooking date.
            if (timeline?.FirstCookedDate is not null && DateOnly.TryParse(timeline.FirstCookedDate, out var firstCooked))
                _timelineFloor = new DateOnly(firstCooked.Year, firstCooked.Month, 1);
            else
                _timelineFloor = null;

            // Cap the start date at the floor so we don't show empty months before the first record.
            _timelineStartDate = _timelineFloor.HasValue && _timelineFloor.Value > timelineFrom
                ? _timelineFloor.Value
                : timelineFrom;

            _canLoadMoreTimeline = _timelineFloor.HasValue && _timelineStartDate > _timelineFloor.Value;
        }
        catch
        {
            NavigationManager.NavigateTo("/housemates", replace: true);
            return;
        }
        finally
        {
            _isLoading = false;
            LoadingIndicator.DecrementAsync();
            StateHasChanged();
        }
    }

    private async Task LoadHousemateNameAsync(Guid housemateId)
    {
        try
        {
            var housemates = await Http.GetFromJsonAsync<List<HousemateDto>>("housemates");
            if (housemates is not null)
            {
                var housemate = housemates.FirstOrDefault(x => x.Id == housemateId);
                if (housemate is not null)
                {
                    _housemateName = housemate.Name;
                    _housemateColor = housemate.Color;
                }
            }
        }
        catch
        {
            // If we cannot load the housemate list, the name will remain empty and trigger redirect.
        }
    }

    private async Task OnTimeRangeChangedAsync(TimeRange newRange)
    {
        _selectedRange = newRange;

        if (!Guid.TryParse(Id, out var housemateId))
            return;

        _isChangingRange = true;
        StateHasChanged();

        try
        {
            var (from, to) = GetDateRange(_selectedRange);
            var response = await StatisticsApi.GetHousemateStatisticsAsync(housemateId, from, to);

            if (response is not null)
                _statistics = response;
        }
        catch
        {
            // Silently handle — keep previous statistics visible.
        }
        finally
        {
            _isChangingRange = false;
            StateHasChanged();
        }
    }

    private async Task OnLoadMoreTimelineAsync()
    {
        // Fetch data for the previous month (1st of previous month to the day before current start).
        var newEnd = _timelineStartDate.AddDays(-1);
        var newStart = _timelineStartDate.AddMonths(-1);

        // Cap at the timeline floor (1st of the month of the first cooking record).
        if (_timelineFloor.HasValue && newStart < _timelineFloor.Value)
            newStart = _timelineFloor.Value;

        try
        {
            var response = await StatisticsApi.GetHousemateTimelineAsync(_housemateId, newStart, newEnd);

            if (response is null)
                return;

            // If no new cooking days were returned, stop further loading.
            var hasNewData = response.Entries.Any(x => x.CookingDays.Count > 0);
            if (!hasNewData)
            {
                _canLoadMoreTimeline = false;
                _timelineStartDate = newStart;
                StateHasChanged();
                return;
            }

            // Merge new timeline data into existing rows.
            MergeTimelineData(response.Entries);
            _timelineStartDate = newStart;

            // Stop loading if we've reached the floor.
            if (_timelineFloor.HasValue && newStart <= _timelineFloor.Value)
                _canLoadMoreTimeline = false;

            StateHasChanged();
        }
        catch
        {
            // Silently handle — user can try scrolling again.
        }
    }

    private void MergeTimelineData(IReadOnlyList<HousemateTimelineDto> newTimeline)
    {
        // Build a mutable dictionary of existing rows keyed by dish description.
        var rowsByDescription = _timelineRows.ToDictionary(
            x => x.Label,
            x => new HashSet<DateOnly>(x.Dates));

        // Track which dishes are newly added in this merge.
        var newDishDescriptions = new List<string>();

        foreach (var entry in newTimeline)
        {
            // Only include dishes that have cooking days in the new chunk.
            if (entry.CookingDays.Count == 0)
                continue;

            var dates = entry.CookingDays
                .Select(x => DateOnly.Parse(x))
                .ToList();

            if (rowsByDescription.TryGetValue(entry.DishDescription, out var existingDates))
            {
                foreach (var date in dates)
                    existingDates.Add(date);
            }
            else
            {
                rowsByDescription[entry.DishDescription] = new HashSet<DateOnly>(dates);
                newDishDescriptions.Add(entry.DishDescription);
            }
        }

        // Build a lookup for SavedDishId by description from existing and new data.
        var dishIdByDescription = new Dictionary<string, Guid>();
        foreach (var row in _timelineRows)
        {
            if (row.NavigationUri is not null)
            {
                var idPart = row.NavigationUri.Replace("/saved-dishes/", "");
                if (Guid.TryParse(idPart, out var existingDishId))
                    dishIdByDescription.TryAdd(row.Label, existingDishId);
            }
        }
        foreach (var entry in newTimeline)
            dishIdByDescription.TryAdd(entry.DishDescription, entry.SavedDishId);

        // Preserve existing row order, then append new dishes sorted by total cooking days descending.
        var orderedDescriptions = _timelineRows
            .Select(x => x.Label)
            .ToList();

        var sortedNewDishes = newDishDescriptions
            .OrderByDescending(x => rowsByDescription[x].Count)
            .ThenBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();

        orderedDescriptions.AddRange(sortedNewDishes);

        _timelineRows = orderedDescriptions
            .Where(x => rowsByDescription.ContainsKey(x))
            .Select(x => new TimelineChart.TimelineChartRow(
                x,
                _housemateColor,
                rowsByDescription[x],
                dishIdByDescription.TryGetValue(x, out var dishId) ? $"/saved-dishes/{dishId}" : null))
            .ToList();
    }

    private IReadOnlyList<TimelineChart.TimelineChartRow> BuildTimelineRows(IReadOnlyList<HousemateTimelineDto> timeline)
    {
        // Sort by most cooked by this housemate in the loaded timeline data.
        // Only include dishes that have cooking days in the loaded range.
        return timeline
            .Where(x => x.CookingDays.Count > 0)
            .OrderByDescending(x => x.CookingDays.Count)
            .ThenBy(x => x.DishDescription, StringComparer.OrdinalIgnoreCase)
            .Select(x => new TimelineChart.TimelineChartRow(
                x.DishDescription,
                _housemateColor,
                x.CookingDays.Select(d => DateOnly.Parse(d)).ToHashSet(),
                $"/saved-dishes/{x.SavedDishId}"))
            .ToList();
    }

    private static (DateOnly From, DateOnly To) GetDateRange(TimeRange range)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var from = range switch
        {
            TimeRange.ThirtyDays => today.AddDays(-30),
            TimeRange.ThreeMonths => today.AddMonths(-3),
            TimeRange.OneYear => today.AddYears(-1),
            TimeRange.AllTime => new DateOnly(2000, 1, 1),
            _ => throw new InvalidOperationException($"Unknown TimeRange value: {range}")
        };
        return (from, today);
    }

    private static (DateOnly TimelineFrom, DateOnly TimelineTo) GetTimelineRange()
    {
        // Pre-load timeline data from the 1st of two months prior through today.
        // E.g. if today is July 26, load from May 1. If today is July 1, still load from May 1.
        var today = DateOnly.FromDateTime(DateTime.Today);
        var timelineFrom = new DateOnly(today.Year, today.Month, 1).AddMonths(-2);
        return (timelineFrom, today);
    }

    private string GetRangeHeaderLabel()
    {
        return _selectedRange switch
        {
            TimeRange.ThirtyDays => Localizer["Stats_RangeHeader_30Days"],
            TimeRange.ThreeMonths => Localizer["Stats_RangeHeader_3Months"],
            TimeRange.OneYear => Localizer["Stats_RangeHeader_1Year"],
            TimeRange.AllTime => Localizer["Stats_AllTime"],
            _ => throw new InvalidOperationException($"Unknown TimeRange value: {_selectedRange}")
        };
    }

    private string GetShortRangeLabel()
    {
        return _selectedRange switch
        {
            TimeRange.ThirtyDays => Localizer["Stats_ShortRange_30d"],
            TimeRange.ThreeMonths => Localizer["Stats_ShortRange_3mo"],
            TimeRange.OneYear => Localizer["Stats_ShortRange_1yr"],
            TimeRange.AllTime => Localizer["Stats_ShortRange_AllTime"],
            _ => throw new InvalidOperationException($"Unknown TimeRange value: {_selectedRange}")
        };
    }

    private async Task NavigateBackAsync()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
