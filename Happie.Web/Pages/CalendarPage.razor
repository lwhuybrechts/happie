@page "/calendar"
@page "/calendar/{date}"
@using System.Globalization
@using Happie.Shared.Contracts
@using Happie.Shared.Domain
@using Happie.Web.Services.Caching
@inject ICachedApiClient CachedApi
@inject IConnectivityService ConnectivityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<AppStrings> Localizer
@inject LocaleService LocaleService
@inject LoadingIndicatorState LoadingIndicator
@implements IAsyncDisposable

<PageTitle>Happie</PageTitle>

@{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var isOnTodaysMonth = _viewedMonth.Year == today.Year && _viewedMonth.Month == today.Month;
}

<div class="calendar-page" @ref="_calendarElement">
    @if (HasSelectedDateInViewedMonth())
    {
        <DateNavigationPanel @ref="_navPanel"
                             @key="@_viewedMonth"
                             ViewedDate="@GetViewedDate()"
                             CenterText="@GetMonthLabel()"
                             PreviousCenterText="@GetPreviousMonthLabel()"
                             NextCenterText="@GetNextMonthLabel()"
                             EnableSliding="true"
                             OnPreviousDay="GoToPreviousMonth"
                             OnNextDay="GoToNextMonth"
                             OnCenterClicked="NavigateToDayPlan" />
    }
    else
    {
        <DateNavigationPanel @ref="_navPanel"
                             @key="@_viewedMonth"
                             ViewedDate="@GetViewedDate()"
                             CenterText="@GetMonthLabel()"
                             PreviousCenterText="@GetPreviousMonthLabel()"
                             NextCenterText="@GetNextMonthLabel()"
                             EnableSliding="true"
                             OnPreviousDay="GoToPreviousMonth"
                             OnNextDay="GoToNextMonth" />
    }

    @if (_loadError)
    {
        <p role="alert">@Localizer["DayPlan_LoadError"]</p>
        <button @onclick="RetryAsync">@Localizer["Calendar_Retry"]</button>
    }
    else if (_noDataOffline)
    {
        <p>@Localizer["Calendar_NoDataOffline"]</p>
    }
    else
    {
        <CalendarGrid Days="@_days"
                      ViewedMonth="@_viewedMonth"
                      SelectedDate="@_selectedDate"
                      OnDayClicked="OnDayClicked" />
    }

    @if (!isOnTodaysMonth)
    {
        <button class="calendar-page__today-btn" @onclick="GoToToday">
            @Localizer["Calendar_GoToToday"]
        </button>
    }

    <p class="calendar-page__info">@Localizer["Calendar_InfoText"]</p>
</div>

@code {
    [Parameter]
    public string? Date { get; set; }

    private IReadOnlyList<CalendarDayDto> _days = [];
    private DateOnly _viewedMonth;
    private DateOnly? _selectedDate;
    private bool _loadError;
    private bool _noDataOffline;
    private CancellationTokenSource? _prefetchCts;
    private ElementReference _calendarElement;
    private DotNetObjectReference<CalendarPage>? _dotNetRef;
    private DateNavigationPanel? _navPanel;

    protected override void OnInitialized()
    {
        CachedApi.OnCalendarUpdated += HandleCalendarUpdated;
    }

    protected override async Task OnParametersSetAsync()
    {
        DateOnly newViewedMonth;
        DateOnly? newSelectedDate;

        if (DateOnly.TryParseExact(Date, "yyyy-MM-dd", out var parsedDate))
        {
            newViewedMonth = new DateOnly(parsedDate.Year, parsedDate.Month, 1);
            newSelectedDate = parsedDate;
        }
        else
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            newViewedMonth = new DateOnly(today.Year, today.Month, 1);
            newSelectedDate = null;
        }

        // Skip reload if the viewed month hasn't changed (e.g. scroll updated the URL within the same month).
        var monthChanged = newViewedMonth != _viewedMonth;
        _viewedMonth = newViewedMonth;
        _selectedDate = newSelectedDate;

        if (monthChanged || _days.Count == 0)
            await LoadCalendarDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("happie.registerCalendarScroll", _calendarElement, _dotNetRef);
        }

        // Re-register the month slider after every render because @key recreates the DateNavigationPanel
        // on month change, which destroys the previous element reference.
        if (_navPanel is not null)
            await JsRuntime.InvokeVoidAsync("happie.registerMonthSlider", _navPanel.NavElement, _dotNetRef, _calendarElement);
    }

    [JSInvokable]
    public async Task ScrollNextDay()
    {
        var current = _selectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        var next = current.AddDays(1);

        _selectedDate = next;

        // If the new date crosses into the next month, switch the viewed month.
        if (next.Month != _viewedMonth.Month || next.Year != _viewedMonth.Year)
        {
            _viewedMonth = new DateOnly(next.Year, next.Month, 1);
            await LoadCalendarDataAsync();
        }

        // Update the URL so other components (e.g. bottom nav) can read the selected date.
        NavigationManager.NavigateTo($"/calendar/{next:yyyy-MM-dd}", replace: true);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task ScrollPreviousDay()
    {
        var current = _selectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        var previous = current.AddDays(-1);

        _selectedDate = previous;

        // If the new date crosses into the previous month, switch the viewed month.
        if (previous.Month != _viewedMonth.Month || previous.Year != _viewedMonth.Year)
        {
            _viewedMonth = new DateOnly(previous.Year, previous.Month, 1);
            await LoadCalendarDataAsync();
        }

        // Update the URL so other components (e.g. bottom nav) can read the selected date.
        NavigationManager.NavigateTo($"/calendar/{previous:yyyy-MM-dd}", replace: true);
        StateHasChanged();
    }

    private string GetMonthLabel()
    {
        var culture = new CultureInfo(LocaleService.CurrentLocale.ToCultureCode());
        return _viewedMonth.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", culture);
    }

    private string GetPreviousMonthLabel()
    {
        var culture = new CultureInfo(LocaleService.CurrentLocale.ToCultureCode());
        return _viewedMonth.AddMonths(-1).ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", culture);
    }

    private string GetNextMonthLabel()
    {
        var culture = new CultureInfo(LocaleService.CurrentLocale.ToCultureCode());
        return _viewedMonth.AddMonths(1).ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", culture);
    }

    private DateOnly GetViewedDate()
    {
        // Use the selected date if available, otherwise the first of the viewed month.
        return _selectedDate ?? _viewedMonth;
    }

    private bool HasSelectedDateInViewedMonth()
    {
        return _selectedDate.HasValue
            && _selectedDate.Value.Year == _viewedMonth.Year
            && _selectedDate.Value.Month == _viewedMonth.Month;
    }

    private async Task GoToPreviousMonth()
    {
        if (await TryMonthSlideAsync(1))
            return;

        _viewedMonth = _viewedMonth.AddMonths(-1);
        await LoadCalendarDataAsync();
        StateHasChanged();
    }

    private async Task GoToNextMonth()
    {
        if (await TryMonthSlideAsync(-1))
            return;

        _viewedMonth = _viewedMonth.AddMonths(1);
        await LoadCalendarDataAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Attempts to trigger the month slide animation programmatically on touch-capable devices.
    /// Returns true if the animation was started (navigation will happen via SlideLeftAsync/SlideRightAsync callback).
    /// </summary>
    private async Task<bool> TryMonthSlideAsync(int direction)
    {
        try
        {
            var hasTouch = await JsRuntime.InvokeAsync<bool>("happie.hasTouchSupport");
            if (!hasTouch)
                return false;

            if (_navPanel is null)
                return false;

            var started = await JsRuntime.InvokeAsync<bool>("happie.triggerMonthSlide", _navPanel.NavElement, direction, _calendarElement);
            return started;
        }
        catch
        {
            return false;
        }
    }

    [JSInvokable]
    public async Task SlideLeftAsync()
    {
        _viewedMonth = _viewedMonth.AddMonths(1);
        await LoadCalendarDataAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task SlideRightAsync()
    {
        _viewedMonth = _viewedMonth.AddMonths(-1);
        await LoadCalendarDataAsync();
        StateHasChanged();
    }

    private void NavigateToDayPlan()
    {
        // Navigate to the day plan for the selected date, or today if none selected.
        var targetDate = _selectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        NavigationManager.NavigateTo($"/day/{targetDate:yyyy-MM-dd}");
    }

    private void OnDayClicked(DateOnly date)
    {
        NavigationManager.NavigateTo($"/day/{date:yyyy-MM-dd}");
    }

    private Task GoToToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _viewedMonth = new DateOnly(today.Year, today.Month, 1);
        _selectedDate = today;
        NavigationManager.NavigateTo($"/calendar/{today:yyyy-MM-dd}", replace: true);
        return LoadCalendarDataAsync();
    }

    private async Task LoadCalendarDataAsync()
    {
        // Cancel any in-flight prefetches from the previous month.
        _prefetchCts?.Cancel();
        _prefetchCts?.Dispose();
        _prefetchCts = new CancellationTokenSource();

        _loadError = false;
        _noDataOffline = false;

        // Clear dots but keep the grid visible so the new month renders immediately.
        _days = [];
        LoadingIndicator.IncrementAsync();

        // Capture the month we're loading so we can detect stale results after await.
        var targetMonth = _viewedMonth;

        // Yield to allow the UI to render the new month's grid (empty dots) before fetching.
        StateHasChanged();
        await Task.Yield();

        // If the user navigated away while we yielded, abandon this load.
        if (_viewedMonth != targetMonth)
        {
            LoadingIndicator.DecrementAsync();
            return;
        }

        var fetchResult = await CachedApi.GetCalendarAsync(targetMonth);

        // If the user navigated to a different month while we were fetching, discard the result.
        if (_viewedMonth != targetMonth)
        {
            LoadingIndicator.DecrementAsync();
            return;
        }

        if (fetchResult.Data is not null)
        {
            _days = fetchResult.Data.Days;

            if (fetchResult.BackgroundRefreshTask is not null)
            {
                // Stale-while-revalidate: let background refresh complete without blocking UI.
                _ = fetchResult.BackgroundRefreshTask;
            }

            LoadingIndicator.DecrementAsync();
            _ = PrefetchAdjacentMonthsAsync();
        }
        else if (fetchResult.HasLoadError)
        {
            _loadError = true;
            LoadingIndicator.DecrementAsync();
        }
        else if (!ConnectivityService.IsOnline)
        {
            _noDataOffline = true;
            LoadingIndicator.DecrementAsync();
        }
        else
        {
            // Null result with no error and online — treat as load error.
            _loadError = true;
            LoadingIndicator.DecrementAsync();
        }
    }

    private async Task PrefetchAdjacentMonthsAsync()
    {
        var cancellationToken = _prefetchCts?.Token ?? CancellationToken.None;

        try
        {
            // Yield to ensure the active month renders and paints before prefetch network requests start.
            await Task.Yield();

            if (cancellationToken.IsCancellationRequested)
                return;

            // Skip prefetch entirely when offline.
            if (!ConnectivityService.IsOnline)
                return;

            // Prefetch next month first (users more commonly navigate forward).
            var nextMonth = _viewedMonth.AddMonths(1);
            try
            {
                var nextResult = await CachedApi.GetCalendarAsync(nextMonth);
                // Discard the BackgroundRefreshTask (fire-and-forget for prefetch).
                _ = nextResult.BackgroundRefreshTask;
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch
            {
                // Next month prefetch failed — continue to previous month per Requirement 4.3.
            }

            if (cancellationToken.IsCancellationRequested)
                return;

            // Prefetch previous month.
            var prevMonth = _viewedMonth.AddMonths(-1);
            var prevResult = await CachedApi.GetCalendarAsync(prevMonth);
            // Discard the BackgroundRefreshTask (fire-and-forget for prefetch).
            _ = prevResult.BackgroundRefreshTask;
        }
        catch (OperationCanceledException)
        {
            // Navigation or dispose cancelled the prefetch — expected, swallow silently.
        }
        catch
        {
            // Prefetch failures are silent — do not surface errors.
        }
    }

    private async Task RetryAsync()
    {
        _loadError = false;
        _days = [];
        LoadingIndicator.IncrementAsync();

        var result = await CachedApi.RetryCalendarAsync(_viewedMonth);

        if (result is not null)
        {
            _days = result.Days;
            LoadingIndicator.DecrementAsync();
            _ = PrefetchAdjacentMonthsAsync();
        }
        else if (!ConnectivityService.IsOnline)
        {
            _noDataOffline = true;
            LoadingIndicator.DecrementAsync();
        }
        else
        {
            _loadError = true;
            LoadingIndicator.DecrementAsync();
        }
    }

    private void HandleCalendarUpdated(DateOnly month, CalendarResponse updatedCalendar)
    {
        // Only apply the update if it's for the currently viewed month.
        if (month != _viewedMonth)
            return;

        _days = updatedCalendar.Days;
        InvokeAsync(StateHasChanged);
    }

    private static (DateOnly Start, DateOnly End) GetVisibleDateRange(DateOnly viewedMonth)
    {
        return CalendarGridService.GetVisibleDateRange(viewedMonth);
    }

    public async ValueTask DisposeAsync()
    {
        CachedApi.OnCalendarUpdated -= HandleCalendarUpdated;
        _prefetchCts?.Cancel();
        _prefetchCts?.Dispose();
        if (_navPanel is not null)
            await JsRuntime.InvokeVoidAsync("happie.disposeMonthSlider", _navPanel.NavElement, _calendarElement);
        await JsRuntime.InvokeVoidAsync("happie.unregisterCalendarScroll", _calendarElement);
        _dotNetRef?.Dispose();
    }
}
