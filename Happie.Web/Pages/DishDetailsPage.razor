@page "/saved-dishes/{Id}"
@using Happie.Shared.Contracts
@using Happie.Web.Services.Caching
@inject ICachedApiClient CachedApi
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AppStrings> Localizer
@inject IJSRuntime JS

<PageTitle>Happie</PageTitle>

<div class="dish-details-page">
    @if (_isLoading)
    {
        <LoadingIndicator />
    }
    else
    {
        <div class="dish-details-page__header">
            @if (!_isEditingName)
            {
                <button class="dish-details-page__back-btn" @onclick="NavigateBackAsync" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                </button>
            }

            @if (_isEditingName)
            {
                <div class="dish-details-page__edit-name">
                    <input class="dish-details-page__name-input"
                           @ref="_nameInputRef"
                           value="@_editNameValue"
                           @oninput="OnNameInput"
                           @onkeydown="OnNameKeyDownAsync"
                           maxlength="100"
                           aria-label="@Localizer["DishDetails_NameInputAriaLabel"]" />
                    <button class="dish-details-page__icon-btn dish-details-page__icon-btn--confirm"
                            @onclick="ConfirmNameAsync"
                            disabled="@(!IsNameConfirmEnabled)"
                            aria-label="@Localizer["DishDetails_Confirm"]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </button>
                    <button class="dish-details-page__icon-btn dish-details-page__icon-btn--discard"
                            @onclick="DiscardNameEdit"
                            aria-label="@Localizer["DishDetails_Discard"]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" />
                            <path d="m15 9-6 6" />
                            <path d="m9 9 6 6" />
                        </svg>
                    </button>
                </div>
            }
            else
            {
                <h1 class="dish-details-page__title">@_dishDescription</h1>
                <button class="dish-details-page__icon-btn" @onclick="StartNameEdit" aria-label="@Localizer["DishDetails_EditName"]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                </button>
                <button class="dish-details-page__stats-btn" @onclick="NavigateToStats" aria-label="@Localizer["SavedDishes_Statistics", _dishDescription]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </button>
            }
        </div>

        @if (_nameConflictError is not null)
        {
            <div class="dish-details-page__name-error" role="alert">
                @_nameConflictError
            </div>
        }

        <SummaryPanel SavedDishId="@_dishId" OnServingsChanged="HandleServingsChanged" />
        <IngredientsPanel SavedDishId="@_dishId" BaseServings="@_baseServings" />
        <InstructionsPanel SavedDishId="@_dishId" />
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private string _dishDescription = string.Empty;
    private bool _isLoading = true;
    private Guid _dishId;
    private int? _baseServings;

    // Name editing state.
    private bool _isEditingName;
    private string _editNameValue = string.Empty;
    private string? _nameConflictError;
    private ElementReference _nameInputRef;
    private bool _shouldFocusNameInput;

    private bool IsNameConfirmEnabled
    {
        get
        {
            var trimmed = _editNameValue.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
                return false;
            if (string.Equals(trimmed, _dishDescription, StringComparison.Ordinal))
                return false;
            return true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var dishId))
        {
            NavigationManager.NavigateTo("/saved-dishes", replace: true);
            return;
        }

        _dishId = dishId;
        await LoadDataAsync(dishId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusNameInput)
        {
            _shouldFocusNameInput = false;
            try { await _nameInputRef.FocusAsync(); } catch { }
        }
    }

    private async Task LoadDataAsync(Guid dishId)
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await CachedApi.GetSavedDishesAsync();
            if (result.Dishes is not null)
            {
                var dish = result.Dishes.FirstOrDefault(x => x.Id == dishId);
                if (dish is not null)
                {
                    _dishDescription = dish.Description;
                }
                else
                {
                    NavigationManager.NavigateTo("/saved-dishes", replace: true);
                    return;
                }
            }
            else
            {
                NavigationManager.NavigateTo("/saved-dishes", replace: true);
                return;
            }
        }
        catch
        {
            NavigationManager.NavigateTo("/saved-dishes", replace: true);
            return;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        // Load base servings from the recipe summary for IngredientsPanel.
        try
        {
            var summary = await Http.GetFromJsonAsync<RecipeSummaryResponse>($"saved-dishes/{dishId}/summary");
            if (summary is not null)
                _baseServings = summary.Servings;
        }
        catch
        {
            // If summary can't be loaded, leave servings null.
        }
    }

    // --- Name editing ---

    private void StartNameEdit()
    {
        _isEditingName = true;
        _editNameValue = _dishDescription;
        _nameConflictError = null;
        _shouldFocusNameInput = true;
    }

    private void OnNameInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        // Block the '&' character.
        _editNameValue = value.Replace("&", "");
        _nameConflictError = null;
    }

    private async Task ConfirmNameAsync()
    {
        var trimmed = _editNameValue.Trim();

        // Reject empty or whitespace-only input without calling backend.
        if (string.IsNullOrWhiteSpace(trimmed))
            return;

        // If unchanged, do nothing.
        if (string.Equals(trimmed, _dishDescription, StringComparison.Ordinal))
            return;

        try
        {
            var response = await Http.PutAsJsonAsync($"saved-dishes/{Id}", new UpdateSavedDishRequest(trimmed));

            if (response.IsSuccessStatusCode)
            {
                var updatedDish = await response.Content.ReadFromJsonAsync<SavedDishDto>();
                if (updatedDish is not null)
                    _dishDescription = updatedDish.Description;
                else
                    _dishDescription = trimmed;

                _isEditingName = false;
                _nameConflictError = null;
                await CachedApi.RefreshSavedDishesCacheAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _nameConflictError = Localizer["DishDetails_NameConflict"];
            }
            else
            {
                _nameConflictError = Localizer["DishDetails_SaveError"];
            }
        }
        catch
        {
            _nameConflictError = Localizer["DishDetails_SaveError"];
        }
    }

    private void DiscardNameEdit()
    {
        _isEditingName = false;
        _editNameValue = _dishDescription;
        _nameConflictError = null;
    }

    private async Task OnNameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ConfirmNameAsync();
        else if (args.Key == "Escape")
            DiscardNameEdit();
    }

    // --- Navigation ---

    private void HandleServingsChanged(int? servings)
    {
        _baseServings = servings;
    }

    private async Task NavigateBackAsync()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void NavigateToStats()
    {
        NavigationManager.NavigateTo($"/saved-dishes/{Id}/stats");
    }
}
