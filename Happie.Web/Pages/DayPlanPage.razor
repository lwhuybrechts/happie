@page "/day/{date}"
@using Happie.Shared.Contracts
@using Happie.Shared.Domain
@using Happie.Web.Services.Caching
@inject ICachedApiClient CachedApi
@inject ISyncService SyncService
@inject IConnectivityService ConnectivityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<AppStrings> Localizer
@inject ActiveHousemateService ActiveHousemateService
@inject LoadingIndicatorState LoadingIndicator
@implements IAsyncDisposable

<PageTitle>Happie</PageTitle>

<div class="day-plan-page"
     @ref="_pageElement">

    <div class="day-plan-page__static-header">
        <DateNavigationPanel ViewedDate="@_parsedDate"
                             PreviousDate="@_prevDate"
                             NextDate="@_nextDate"
                             EnableSliding="true"
                             OnPreviousDay="GoToPreviousDay"
                             OnNextDay="GoToNextDay"
                             OnCenterClicked="NavigateToCalendar" />
    </div>

    <div class="swipe-carousel-viewport">
        <div class="swipe-carousel" @ref="_carouselElement">
        <div class="swipe-carousel__panel swipe-carousel__panel--prev">
            @* @key forces Blazor to recreate (not reuse) child components when the date changes.
               Without it, Blazor diffs the AttendanceSection in-place during panel recycling,
               briefly exposing stale internal state (collapse/expand, optimistic overrides) from
               the previous day before new parameters propagate — visible as a color flash. *@
            @if (_prevLoaded && _prevDayPlan is not null)
            {
                <div class="swipe-carousel__panel-content" @key="@($"prev-{_prevDate}")">
                    <DishPanel Date="@_prevDate.ToString("yyyy-MM-dd")"
                               Dish="@_prevDayPlan.Dish"
                               Attendance="@_prevDayPlan.Attendance"
                               ActingHousemateId="@_activeHousemateId"
                               OnDishChanged="@(_ => Task.CompletedTask)" />

                    <AttendanceSection Date="@_prevDate.ToString("yyyy-MM-dd")"
                                       Attendance="@_prevDayPlan.Attendance"
                                       OnNudgeClicked="@(() => { })"
                                       OnStatusChanged="@(_ => Task.CompletedTask)"
                                       OnChefChanged="@(_ => Task.CompletedTask)" />

                    <CommentsSection Date="@_prevDate.ToString("yyyy-MM-dd")"
                                     Comments="@_prevDayPlan.Comments"
                                     Attendance="@_prevDayPlan.Attendance"
                                     ActiveHousemateId="@_activeHousemateId"
                                     OnCommentChanged="@(_ => Task.CompletedTask)" />

                    <HistorySection History="@_prevDayPlan.History"
                                    Attendance="@_prevDayPlan.Attendance" />
                </div>
            }
            else
            {
                <div class="swipe-carousel__panel-content swipe-carousel__panel-content--loading">
                    <p>@Localizer["DayPlan_Loading"]</p>
                </div>
            }
        </div>

        <div class="swipe-carousel__panel swipe-carousel__panel--active">
            <div class="swipe-carousel__panel-content" @key="@($"active-{_parsedDate}")">
                @if (_isLoading)
                {
                    <p>@Localizer["DayPlan_Loading"]</p>
                }
                else if (_loadError)
                {
                    <p role="alert">@Localizer["DayPlan_LoadError"]</p>
                    <button @onclick="RetryAsync">@Localizer["DayPlan_Retry"]</button>
                }
                else if (_noDataOffline)
                {
                    <p>@Localizer["DayPlan_NoDataOffline"]</p>
                }
                else if (_dayPlan is not null)
                {
                    <DishPanel @ref="_activeDishPanel"
                               Date="@Date"
                               Dish="@_dayPlan.Dish"
                               Attendance="@_dayPlan.Attendance"
                               ActingHousemateId="@_activeHousemateId"
                               SavedDishModalRef="@_savedDishModal"
                               OnDishChanged="OnDishChangedAsync" />

                    <AttendanceSection Date="@Date"
                                       Attendance="@_dayPlan.Attendance"
                                       OnNudgeClicked="OpenNudgeModal"
                                       OnStatusChanged="OnAttendanceChangedAsync"
                                       OnChefChanged="OnChefChangedAsync" />

                    <CommentsSection Date="@Date"
                                     Comments="@_dayPlan.Comments"
                                     Attendance="@_dayPlan.Attendance"
                                     ActiveHousemateId="@_activeHousemateId"
                                     OnCommentChanged="OnCommentChangedAsync" />

                    <HistorySection History="@_dayPlan.History"
                                    Attendance="@_dayPlan.Attendance" />
                }
            </div>
        </div>

        <div class="swipe-carousel__panel swipe-carousel__panel--next">
            @if (_nextLoaded && _nextDayPlan is not null)
            {
                <div class="swipe-carousel__panel-content" @key="@($"next-{_nextDate}")">
                    <DishPanel Date="@_nextDate.ToString("yyyy-MM-dd")"
                               Dish="@_nextDayPlan.Dish"
                               Attendance="@_nextDayPlan.Attendance"
                               ActingHousemateId="@_activeHousemateId"
                               OnDishChanged="@(_ => Task.CompletedTask)" />

                    <AttendanceSection Date="@_nextDate.ToString("yyyy-MM-dd")"
                                       Attendance="@_nextDayPlan.Attendance"
                                       OnNudgeClicked="@(() => { })"
                                       OnStatusChanged="@(_ => Task.CompletedTask)"
                                       OnChefChanged="@(_ => Task.CompletedTask)" />

                    <CommentsSection Date="@_nextDate.ToString("yyyy-MM-dd")"
                                     Comments="@_nextDayPlan.Comments"
                                     Attendance="@_nextDayPlan.Attendance"
                                     ActiveHousemateId="@_activeHousemateId"
                                     OnCommentChanged="@(_ => Task.CompletedTask)" />

                    <HistorySection History="@_nextDayPlan.History"
                                    Attendance="@_nextDayPlan.Attendance" />
                </div>
            }
            else
            {
                <div class="swipe-carousel__panel-content swipe-carousel__panel-content--loading">
                    <p>@Localizer["DayPlan_Loading"]</p>
                </div>
            }
        </div>
        </div>
    </div>

    @if (_dayPlan is not null)
    {
        <NudgeModal @ref="_nudgeModal"
                    Attendance="@_dayPlan.Attendance"
                    ActiveHousemateId="@_activeHousemateId"
                    Date="@Date" />
    }

    <SavedDishModal @ref="_savedDishModal"
                    OnConfirm="HandleSavedDishConfirm"
                    OnCustomMode="HandleSavedDishCustomMode" />
</div>

@code {
    [Parameter]
    public string Date { get; set; } = string.Empty;

    private DayPlanResponse? _dayPlan;
    private DateOnly _parsedDate;
    private bool _isLoading = true;
    private bool _loadError;
    private bool _noDataOffline;
    private Guid _activeHousemateId;
    private ElementReference _pageElement;
    private ElementReference _carouselElement;
    private DotNetObjectReference<DayPlanPage>? _dotNetRef;
    private NudgeModal? _nudgeModal;
    private SavedDishModal _savedDishModal = default!;
    private DishPanel? _activeDishPanel;

    // Carousel state: adjacent day plans.
    private DayPlanResponse? _prevDayPlan;
    private DayPlanResponse? _nextDayPlan;
    private bool _prevLoaded;
    private bool _nextLoaded;
    private bool _isSwiping;
    private CancellationTokenSource? _prefetchCts;
    private DateOnly _prevDate;
    private DateOnly _nextDate;
    private DateOnly _previousParsedDate;
    private List<Action>? _deferredUpdates;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await ActiveHousemateService.InitializeAsync();
        _activeHousemateId = ActiveHousemateService.Id ?? Guid.Empty;
        CachedApi.OnDayPlanUpdated += HandleDayPlanUpdated;
        SyncService.OnDayPlanRolledBack += HandleDayPlanRolledBack;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", out _parsedDate))
        {
            // Fall back to today if the route parameter is malformed.
            _parsedDate = DateOnly.FromDateTime(DateTime.Today);
        }

        // Cancel any in-flight pre-fetches from the previous date.
        _prefetchCts?.Cancel();
        _prefetchCts?.Dispose();
        _prefetchCts = new CancellationTokenSource();

        // Update adjacent dates immediately so the DateNavigationPanel shows correct labels
        // even while LoadDayPlanAsync is in progress.
        _prevDate = _parsedDate.AddDays(-1);
        _nextDate = _parsedDate.AddDays(1);

        // Determine navigation direction relative to the previous date.
        var dayDifference = _parsedDate.DayNumber - _previousParsedDate.DayNumber;

        if (dayDifference == 1 && _nextLoaded && _nextDayPlan is not null)
        {
            // Navigated forward: recycle panels.
            _prevDayPlan = _dayPlan;
            _prevLoaded = _prevDayPlan is not null;
            _dayPlan = _nextDayPlan;
            _isLoading = false;
            _loadError = false;
            _noDataOffline = false;
            _nextDayPlan = null;
            _nextLoaded = false;
        }
        else if (dayDifference == -1 && _prevLoaded && _prevDayPlan is not null)
        {
            // Navigated backward: recycle panels.
            _nextDayPlan = _dayPlan;
            _nextLoaded = _nextDayPlan is not null;
            _dayPlan = _prevDayPlan;
            _isLoading = false;
            _loadError = false;
            _noDataOffline = false;
            _prevDayPlan = null;
            _prevLoaded = false;
        }
        else
        {
            // Non-adjacent navigation or first load: reset all panels and fetch from scratch.
            _prevLoaded = false;
            _nextLoaded = false;
            _prevDayPlan = null;
            _nextDayPlan = null;
            _dayPlan = null;
            _isLoading = true;
            // Fire-and-forget: don't block OnParametersSetAsync so rapid navigation
            // (e.g. pressing the arrow multiple times) isn't queued behind slow loads.
            _ = LoadDayPlanAsync();
        }

        _previousParsedDate = _parsedDate;

        // Fire-and-forget pre-fetch of adjacent days after active day has loaded.
        if (_dayPlan is not null && !_isLoading)
            _ = PreFetchAdjacentDaysAsync();

        // Navigation complete: allow next swipe gesture.
        _isSwiping = false;
        ApplyDeferredUpdates();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("happie.registerSwipeCarousel", _pageElement, _carouselElement, _dotNetRef);
    }

    [JSInvokable]
    public Task SwipeLeftAsync()
    {
        if (_isSwiping)
            return Task.CompletedTask;

        _isSwiping = true;
        var next = _parsedDate.AddDays(1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{next}");
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task SwipeRightAsync()
    {
        if (_isSwiping)
            return Task.CompletedTask;

        _isSwiping = true;
        var previous = _parsedDate.AddDays(-1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{previous}");
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task SwipeCancelledAsync()
    {
        _isSwiping = false;
        ApplyDeferredUpdates();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ApplyDeferredUpdates()
    {
        if (_deferredUpdates is null || _deferredUpdates.Count == 0)
            return;

        foreach (var update in _deferredUpdates)
            update();

        _deferredUpdates = null;
    }

    private async Task GoToNextDay()
    {
        // On touch devices, trigger the slide animation to teach swipe navigation.
        if (await TrySlideNavigationAsync(-1))
            return;

        var next = _parsedDate.AddDays(1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{next}");
    }

    private async Task GoToPreviousDay()
    {
        // On touch devices, trigger the slide animation to teach swipe navigation.
        if (await TrySlideNavigationAsync(1))
            return;

        var previous = _parsedDate.AddDays(-1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{previous}");
    }

    /// <summary>
    /// Attempts to trigger the slide animation programmatically on touch-capable devices.
    /// Returns true if the animation was started (navigation will happen via SwipeLeftAsync/SwipeRightAsync callback).
    /// Returns false on non-touch devices, meaning the caller should navigate directly.
    /// </summary>
    private async Task<bool> TrySlideNavigationAsync(int direction)
    {
        try
        {
            var hasTouch = await JsRuntime.InvokeAsync<bool>("happie.hasTouchSupport");
            if (!hasTouch)
                return false;

            var started = await JsRuntime.InvokeAsync<bool>("happie.triggerSlideNavigation", _pageElement, direction);
            return started;
        }
        catch
        {
            // JS interop failure — fall back to direct navigation.
            return false;
        }
    }

    private void NavigateToCalendar()
    {
        NavigationManager.NavigateTo($"/calendar/{_parsedDate:yyyy-MM-dd}");
    }

    private async Task LoadDayPlanAsync()
    {
        _loadError = false;
        _noDataOffline = false;

        // Capture the date we're loading so we can detect stale results after await.
        var targetDate = Date;

        // Peek the cache first: if data exists for this date, swap it in without any loading flash.
        // CachedApiClient.GetDayPlanAsync returns synchronously from cache or awaits for a cold fetch.
        var fetchResult = await CachedApi.GetDayPlanAsync(targetDate);

        // If the user navigated away while we were fetching, discard the result.
        if (Date != targetDate)
            return;

        if (fetchResult.Data is not null)
        {
            _dayPlan = fetchResult.Data;
            _isLoading = false;
            await InvokeAsync(StateHasChanged);

            // Fire-and-forget pre-fetch of adjacent days now that we have data.
            _ = PreFetchAdjacentDaysAsync();

            // Await background refresh for the active date with loading indicator.
            if (fetchResult.BackgroundRefreshTask is not null)
            {
                LoadingIndicator.IncrementAsync();
                try
                {
                    await fetchResult.BackgroundRefreshTask;
                }
                finally
                {
                    LoadingIndicator.DecrementAsync();
                }
            }
        }
        else if (fetchResult.IsColdCacheFetch && fetchResult.HasLoadError)
        {
            _dayPlan = null;
            _loadError = true;
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
        else if (!ConnectivityService.IsOnline)
        {
            _dayPlan = null;
            _noDataOffline = true;
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            // Null result with no error and online — treat as load error.
            _dayPlan = null;
            _loadError = true;
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreFetchAdjacentDaysAsync()
    {
        var cancellationToken = _prefetchCts?.Token ?? CancellationToken.None;

        try
        {
            // Yield to ensure the active panel renders and paints before adjacent panel rendering begins.
            // This satisfies requirement 10.1: Active_Panel content rendered to DOM before Adjacent_Panel content.
            await Task.Yield();

            if (cancellationToken.IsCancellationRequested)
                return;

            // Only fetch adjacent days that are not already loaded from panel recycling.
            Task<DayPlanFetchResult>? prevTask = _prevLoaded ? null : CachedApi.GetDayPlanAsync(_prevDate.ToString("yyyy-MM-dd"));
            Task<DayPlanFetchResult>? nextTask = _nextLoaded ? null : CachedApi.GetDayPlanAsync(_nextDate.ToString("yyyy-MM-dd"));

            if (prevTask is not null)
                await prevTask;
            if (nextTask is not null)
                await nextTask;

            if (cancellationToken.IsCancellationRequested)
                return;

            if (prevTask is not null)
            {
                var prevResult = (await prevTask).Data;
                if (prevResult is not null)
                {
                    // Defer panel update if a swipe gesture is in progress.
                    if (_isSwiping)
                    {
                        _deferredUpdates ??= new List<Action>();
                        _deferredUpdates.Add(() =>
                        {
                            _prevDayPlan = prevResult;
                            _prevLoaded = true;
                        });
                    }
                    else
                    {
                        _prevDayPlan = prevResult;
                        _prevLoaded = true;
                    }
                }
            }

            // Render the first adjacent panel before proceeding to the second.
            // This satisfies requirement 10.2/10.3: if rendering causes frame drops or input lag,
            // defer remaining rendering until idle time (200ms timeout).
            if (!_isSwiping && _prevLoaded)
                await InvokeAsync(StateHasChanged);

            if (cancellationToken.IsCancellationRequested)
                return;

            // Wait for browser idle time before rendering the second adjacent panel.
            // Uses requestIdleCallback with a 200ms timeout fallback to avoid blocking the main thread.
            if (nextTask is not null)
                await JsRuntime.InvokeVoidAsync("happie.waitForIdle");

            if (cancellationToken.IsCancellationRequested)
                return;

            if (nextTask is not null)
            {
                var nextResult = (await nextTask).Data;
                if (nextResult is not null)
                {
                    // Defer panel update if a swipe gesture is in progress.
                    if (_isSwiping)
                    {
                        _deferredUpdates ??= new List<Action>();
                        _deferredUpdates.Add(() =>
                        {
                            _nextDayPlan = nextResult;
                            _nextLoaded = true;
                        });
                    }
                    else
                    {
                        _nextDayPlan = nextResult;
                        _nextLoaded = true;
                    }
                }
            }

            if (!_isSwiping && _nextLoaded)
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Pre-fetch was cancelled due to navigation. Discard results.
        }
        catch
        {
            // Pre-fetch failed. Leave Arrow_Placeholder in place.
        }
    }

    private async Task RetryAsync()
    {
        _loadError = false;
        _isLoading = true;

        var result = await CachedApi.RetryDayPlanAsync(Date);

        if (result is not null)
            _dayPlan = result;
        else if (CachedApi.HasLoadError)
            _loadError = true;
        else if (!ConnectivityService.IsOnline)
            _noDataOffline = true;
        else
            _loadError = true;

        _isLoading = false;
    }

    private void HandleDayPlanUpdated(DayPlanResponse updatedDayPlan)
    {
        if (_isSwiping)
        {
            // Defer state update until the swipe gesture completes.
            _deferredUpdates ??= new List<Action>();
            _deferredUpdates.Add(() => ApplyDayPlanUpdate(updatedDayPlan));
            return;
        }

        ApplyDayPlanUpdate(updatedDayPlan);
    }

    private void ApplyDayPlanUpdate(DayPlanResponse updatedDayPlan)
    {
        // Only apply the update to the panel that matches the response date.
        // A background refresh for a previously viewed or prefetched date must not
        // overwrite the active day's data.
        if (updatedDayPlan.Date == _parsedDate)
        {
            _dayPlan = updatedDayPlan;
            InvokeAsync(StateHasChanged);
        }
        else if (updatedDayPlan.Date == _prevDate)
        {
            _prevDayPlan = updatedDayPlan;
            _prevLoaded = true;
            InvokeAsync(StateHasChanged);
        }
        else if (updatedDayPlan.Date == _nextDate)
        {
            _nextDayPlan = updatedDayPlan;
            _nextLoaded = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleDayPlanRolledBack(string date, DayPlanResponse rolledBackDayPlan)
    {
        // Only update if this rollback is for the currently viewed date.
        if (date != Date)
            return;

        if (_isSwiping)
        {
            // Defer state update until the swipe gesture completes.
            _deferredUpdates ??= new List<Action>();
            _deferredUpdates.Add(() =>
            {
                _dayPlan = rolledBackDayPlan;
                InvokeAsync(StateHasChanged);
            });
            return;
        }

        _dayPlan = rolledBackDayPlan;
        InvokeAsync(StateHasChanged);
    }

    private void OpenNudgeModal()
    {
        _nudgeModal?.Open();
    }

    private async Task OnDishChangedAsync(string? newDescription)
    {
        // Apply the change optimistically to avoid flashing the old value while the refresh loads.
        if (_dayPlan is not null)
        {
            var updatedDish = newDescription is not null
                ? (_dayPlan.Dish is not null
                    ? _dayPlan.Dish with { Description = newDescription }
                    : new DishDto(newDescription, _activeHousemateId, DateTimeOffset.UtcNow, null, null, null))
                : null;

            _dayPlan = _dayPlan with { Dish = updatedDish };
        }

        // Refresh from cache to pick up the latest state after the child's mutation.
        var fetchResult = await CachedApi.GetDayPlanAsync(Date);
        if (fetchResult.Data is not null)
            _dayPlan = fetchResult.Data;
    }

    private async Task OnAttendanceChangedAsync((Guid HousemateId, AttendanceStatus Status) change)
    {
        // Refresh from cache to pick up the latest state after the child's mutation.
        var fetchResult = await CachedApi.GetDayPlanAsync(Date);
        if (fetchResult.Data is not null)
            _dayPlan = fetchResult.Data;
    }

    private async Task OnChefChangedAsync((Guid HousemateId, bool IsChef) change)
    {
        // Refresh from cache to pick up the latest state after the child's mutation.
        var fetchResult = await CachedApi.GetDayPlanAsync(Date);
        if (fetchResult.Data is not null)
            _dayPlan = fetchResult.Data;
    }

    private async Task OnCommentChangedAsync((Guid HousemateId, string? Text) change)
    {
        // Apply the change optimistically to avoid flashing the old value while the refresh loads.
        if (_dayPlan is not null)
        {
            var updatedComments = change.Text is null
                ? _dayPlan.Comments.Where(x => x.HousemateId != change.HousemateId).ToList()
                : _dayPlan.Comments
                    .Select(x => x.HousemateId == change.HousemateId ? x with { Text = change.Text } : x)
                    .ToList();

            // If it's a new comment (not yet in the list), add it.
            if (change.Text is not null && !_dayPlan.Comments.Any(x => x.HousemateId == change.HousemateId))
            {
                var housemate = _dayPlan.Attendance.FirstOrDefault(x => x.HousemateId == change.HousemateId);
                if (housemate is not null)
                    updatedComments.Add(new CommentDto(change.HousemateId, housemate.HousemateName, housemate.Color, change.Text, DateTimeOffset.Now));
            }

            _dayPlan = _dayPlan with { Comments = updatedComments };
        }

        // Refresh from cache to pick up the latest state after the child's mutation.
        var fetchResult = await CachedApi.GetDayPlanAsync(Date);
        if (fetchResult.Data is not null)
            _dayPlan = fetchResult.Data;
    }

    private void HandleSavedDishConfirm(IReadOnlyList<SavedDishDto> dishes)
    {
        _activeDishPanel?.HandleMultiDishConfirm(dishes);
    }

    private void HandleSavedDishCustomMode(string combinedDescription)
    {
        _activeDishPanel?.HandleCustomMode(combinedDescription);
    }

    public async ValueTask DisposeAsync()
    {
        CachedApi.OnDayPlanUpdated -= HandleDayPlanUpdated;
        SyncService.OnDayPlanRolledBack -= HandleDayPlanRolledBack;
        _prefetchCts?.Cancel();
        _prefetchCts?.Dispose();
        await JsRuntime.InvokeVoidAsync("happie.disposeSwipeCarousel", _pageElement);
        _dotNetRef?.Dispose();
    }
}
