@page "/day/{date}"
@using Happie.Shared.Contracts
@using Happie.Shared.Domain
@using Happie.Web.Services.Caching
@inject ICachedApiClient CachedApi
@inject ISyncService SyncService
@inject IConnectivityService ConnectivityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<AppStrings> Localizer
@inject ActiveHousemateService ActiveHousemateService
@implements IAsyncDisposable

<PageTitle>Happie</PageTitle>

<div class="day-plan-page"
     @ref="_pageElement">

    <DateNavigationPanel ViewedDate="@_parsedDate"
                         OnPreviousDay="GoToPreviousDay"
                         OnNextDay="GoToNextDay"
                         OnCenterClicked="NavigateToCalendar" />

    @if (_isLoading)
    {
        <p>@Localizer["DayPlan_Loading"]</p>
    }
    else if (_loadError)
    {
        <p role="alert">@Localizer["DayPlan_LoadError"]</p>
        <button @onclick="RetryAsync">@Localizer["DayPlan_Retry"]</button>
    }
    else if (_noDataOffline)
    {
        <p>@Localizer["DayPlan_NoDataOffline"]</p>
    }
    else if (_dayPlan is not null)
    {
        <DishPanel Date="@Date"
                   Dish="@_dayPlan.Dish"
                   Attendance="@_dayPlan.Attendance"
                   ActingHousemateId="@_activeHousemateId"
                   OnDishChanged="OnDishChangedAsync" />

        <AttendanceSection Date="@Date"
                           Attendance="@_dayPlan.Attendance"
                           OnNudgeClicked="OpenNudgeModal"
                           OnStatusChanged="OnAttendanceChangedAsync"
                           OnChefChanged="OnChefChangedAsync" />

        <CommentsSection Date="@Date"
                         Comments="@_dayPlan.Comments"
                         Attendance="@_dayPlan.Attendance"
                         ActiveHousemateId="@_activeHousemateId"
                         OnCommentChanged="OnCommentChangedAsync" />

        <HistorySection History="@_dayPlan.History"
                        Attendance="@_dayPlan.Attendance" />

        <NudgeModal @ref="_nudgeModal"
                    Attendance="@_dayPlan.Attendance"
                    ActiveHousemateId="@_activeHousemateId"
                    Date="@Date" />
    }
</div>

@code {
    [Parameter]
    public string Date { get; set; } = string.Empty;

    private DayPlanResponse? _dayPlan;
    private DateOnly _parsedDate;
    private bool _isLoading = true;
    private bool _loadError;
    private bool _noDataOffline;
    private Guid _activeHousemateId;
    private ElementReference _pageElement;
    private DotNetObjectReference<DayPlanPage>? _dotNetRef;
    private NudgeModal? _nudgeModal;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await ActiveHousemateService.InitializeAsync();
        _activeHousemateId = ActiveHousemateService.Id ?? Guid.Empty;
        CachedApi.OnDayPlanUpdated += HandleDayPlanUpdated;
        SyncService.OnDayPlanRolledBack += HandleDayPlanRolledBack;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", out _parsedDate))
        {
            // Fall back to today if the route parameter is malformed.
            _parsedDate = DateOnly.FromDateTime(DateTime.Today);
        }

        await LoadDayPlanAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("happie.registerSwipe", _pageElement, _dotNetRef);
    }

    [JSInvokable]
    public Task SwipeLeftAsync() => GoToNextDay();

    [JSInvokable]
    public Task SwipeRightAsync() => GoToPreviousDay();

    private Task GoToNextDay()
    {
        var next = _parsedDate.AddDays(1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{next}");
        return Task.CompletedTask;
    }

    private Task GoToPreviousDay()
    {
        var previous = _parsedDate.AddDays(-1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{previous}");
        return Task.CompletedTask;
    }

    private void NavigateToCalendar()
    {
        NavigationManager.NavigateTo($"/calendar/{_parsedDate:yyyy-MM-dd}");
    }

    private async Task LoadDayPlanAsync()
    {
        _loadError = false;
        _noDataOffline = false;

        // Peek the cache first: if data exists for this date, swap it in without any loading flash.
        // CachedApiClient.GetDayPlanAsync returns synchronously from cache or awaits for a cold fetch.
        var result = await CachedApi.GetDayPlanAsync(Date);

        if (result is not null)
        {
            _dayPlan = result;
            _isLoading = false;
        }
        else if (CachedApi.IsColdCacheFetch && CachedApi.HasLoadError)
        {
            _dayPlan = null;
            _loadError = true;
            _isLoading = false;
        }
        else if (!ConnectivityService.IsOnline)
        {
            _dayPlan = null;
            _noDataOffline = true;
            _isLoading = false;
        }
        else
        {
            // Null result with no error and online — treat as load error.
            _dayPlan = null;
            _loadError = true;
            _isLoading = false;
        }
    }

    private async Task RetryAsync()
    {
        _loadError = false;
        _isLoading = true;

        var result = await CachedApi.RetryDayPlanAsync(Date);

        if (result is not null)
            _dayPlan = result;
        else if (CachedApi.HasLoadError)
            _loadError = true;
        else if (!ConnectivityService.IsOnline)
            _noDataOffline = true;
        else
            _loadError = true;

        _isLoading = false;
    }

    private void HandleDayPlanUpdated(DayPlanResponse updatedDayPlan)
    {
        _dayPlan = updatedDayPlan;
        InvokeAsync(StateHasChanged);
    }

    private void HandleDayPlanRolledBack(string date, DayPlanResponse rolledBackDayPlan)
    {
        // Only update if this rollback is for the currently viewed date.
        if (date == Date)
        {
            _dayPlan = rolledBackDayPlan;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OpenNudgeModal()
    {
        _nudgeModal?.Open();
    }

    private async Task OnDishChangedAsync(string? newDescription)
    {
        // Refresh from cache to pick up the latest state after the child's mutation.
        var result = await CachedApi.GetDayPlanAsync(Date);
        if (result is not null)
            _dayPlan = result;
    }

    private async Task OnAttendanceChangedAsync((Guid HousemateId, AttendanceStatus Status) change)
    {
        // Refresh from cache to pick up the latest state after the child's mutation.
        var result = await CachedApi.GetDayPlanAsync(Date);
        if (result is not null)
            _dayPlan = result;
    }

    private async Task OnChefChangedAsync((Guid HousemateId, bool IsChef) change)
    {
        // Refresh from cache to pick up the latest state after the child's mutation.
        var result = await CachedApi.GetDayPlanAsync(Date);
        if (result is not null)
            _dayPlan = result;
    }

    private async Task OnCommentChangedAsync((Guid HousemateId, string? Text) change)
    {
        // Apply the change optimistically to avoid flashing the old value while the refresh loads.
        if (_dayPlan is not null)
        {
            var updatedComments = change.Text is null
                ? _dayPlan.Comments.Where(x => x.HousemateId != change.HousemateId).ToList()
                : _dayPlan.Comments
                    .Select(x => x.HousemateId == change.HousemateId ? x with { Text = change.Text } : x)
                    .ToList();

            // If it's a new comment (not yet in the list), add it.
            if (change.Text is not null && !_dayPlan.Comments.Any(x => x.HousemateId == change.HousemateId))
            {
                var housemate = _dayPlan.Attendance.FirstOrDefault(x => x.HousemateId == change.HousemateId);
                if (housemate is not null)
                    updatedComments.Add(new CommentDto(change.HousemateId, housemate.HousemateName, housemate.Color, change.Text, DateTimeOffset.Now));
            }

            _dayPlan = _dayPlan with { Comments = updatedComments };
        }

        // Refresh from cache to pick up the latest state after the child's mutation.
        var result = await CachedApi.GetDayPlanAsync(Date);
        if (result is not null)
            _dayPlan = result;
    }

    public async ValueTask DisposeAsync()
    {
        CachedApi.OnDayPlanUpdated -= HandleDayPlanUpdated;
        SyncService.OnDayPlanRolledBack -= HandleDayPlanRolledBack;
        await JsRuntime.InvokeVoidAsync("happie.unregisterSwipe", _pageElement);
        _dotNetRef?.Dispose();
    }
}
