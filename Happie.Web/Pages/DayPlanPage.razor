@page "/day/{date}"
@using Happie.Shared.Contracts
@using Happie.Shared.Domain
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<AppStrings> Localizer
@inject ActiveHousemateService ActiveHousemateService
@implements IAsyncDisposable

<PageTitle>Happie</PageTitle>

<div class="day-plan-page"
     @ref="_pageElement">

    <DateNavigationPanel ViewedDate="@_parsedDate"
                         OnPreviousDay="GoToPreviousDay"
                         OnNextDay="GoToNextDay"
                         OnCenterClicked="NavigateToCalendar" />

    @if (_isLoading)
    {
        <p>@Localizer["DayPlan_Loading"]</p>
    }
    else if (_loadError)
    {
        <p role="alert">@Localizer["DayPlan_LoadError"]</p>
    }
    else if (_dayPlan is not null)
    {
        <DishPanel Date="@Date"
                   Dish="@_dayPlan.Dish"
                   Attendance="@_dayPlan.Attendance"
                   OnDishChanged="OnDishChangedAsync" />

        <AttendanceSection Date="@Date"
                           Attendance="@_dayPlan.Attendance"
                           OnNudgeClicked="OpenNudgeModal"
                           OnStatusChanged="OnAttendanceChangedAsync" />

        <CommentsSection Date="@Date"
                         Comments="@_dayPlan.Comments"
                         Attendance="@_dayPlan.Attendance"
                         ActiveHousemateId="@_activeHousemateId"
                         OnCommentChanged="OnCommentChangedAsync" />

        <HistorySection History="@_dayPlan.History"
                        Attendance="@_dayPlan.Attendance" />

        <NudgeModal @ref="_nudgeModal"
                    Attendance="@_dayPlan.Attendance"
                    ActiveHousemateId="@_activeHousemateId"
                    Date="@Date" />
    }
</div>

@code {
    [Parameter]
    public string Date { get; set; } = string.Empty;

    private DayPlanResponse? _dayPlan;
    private DateOnly _parsedDate;
    private bool _isLoading;
    private bool _loadError;
    private Guid _activeHousemateId;
    private ElementReference _pageElement;
    private DotNetObjectReference<DayPlanPage>? _dotNetRef;
    private NudgeModal? _nudgeModal;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await ActiveHousemateService.InitializeAsync();
        _activeHousemateId = ActiveHousemateService.Id ?? Guid.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", out _parsedDate))
        {
            // Fall back to today if the route parameter is malformed.
            _parsedDate = DateOnly.FromDateTime(DateTime.Today);
        }

        await LoadDayPlanAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("happie.registerSwipe", _pageElement, _dotNetRef);
    }

    [JSInvokable]
    public Task SwipeLeftAsync() => GoToNextDay();

    [JSInvokable]
    public Task SwipeRightAsync() => GoToPreviousDay();

    private Task GoToNextDay()
    {
        var next = _parsedDate.AddDays(1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{next}");
        return Task.CompletedTask;
    }

    private Task GoToPreviousDay()
    {
        var previous = _parsedDate.AddDays(-1).ToString("yyyy-MM-dd");
        NavigationManager.NavigateTo($"/day/{previous}");
        return Task.CompletedTask;
    }

    private void NavigateToCalendar()
    {
        NavigationManager.NavigateTo($"/calendar/{_parsedDate:yyyy-MM-dd}");
    }

    private async Task LoadDayPlanAsync()
    {
        _isLoading = true;
        _loadError = false;
        _dayPlan = null;

        var response = await Http.GetAsync($"days/{Date}");

        if (response.IsSuccessStatusCode)
            _dayPlan = await response.Content.ReadFromJsonAsync<DayPlanResponse>();
        else
            _loadError = true;

        _isLoading = false;
    }

    private void OpenNudgeModal()
    {
        _nudgeModal?.Open();
    }

    private async Task OnDishChangedAsync(string? newDescription)
    {
        // Refresh the day plan data from the API to get updated state.
        await LoadDayPlanAsync();
    }

    private async Task OnAttendanceChangedAsync((Guid HousemateId, AttendanceStatus Status) change)
    {
        // Refresh the day plan data from the API to get updated state.
        await LoadDayPlanAsync();
    }

    private async Task OnCommentChangedAsync((Guid HousemateId, string? Text) change)
    {
        // Refresh the day plan data from the API to get updated state.
        await LoadDayPlanAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await JsRuntime.InvokeVoidAsync("happie.unregisterSwipe", _pageElement);
        _dotNetRef?.Dispose();
    }
}
